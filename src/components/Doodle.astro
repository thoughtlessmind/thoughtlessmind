---
// The landing doodle: telescope, dotted route, ringed planet, moon, pendulum, stars and a rocket, traced from the
// Codex line art into strokes on currentColor (the tracer lives in the local docs/v4-research/art/vector/). It draws
// itself once when the content rises (DESIGN.md §4): each stroke carries its delay (--d) and duration (--t) in ms.
// The planet is generated (scripts/planet.ts) and keeps turning, with its rings; the pendulum keeps swinging. All of it
// holds still while the doodle is off screen.
// With `art`, a section doodle instead (DESIGN.md §5): traced the same way and drawn twice. `.rest` is always on
// show, a pencil sketch in --muted. Over it `.ink`, the same lines in --ink, sits inside a clip path that is empty
// until a mouse comes over the box; then a jelly blob trails the cursor (scripts/blob.ts) and inks the sketch under
// it. Both copies run the same loops on the same clock, so they stay in register; the ink copy's ids get a suffix.
import doodle from '../assets/doodle.svg?raw';
import writing from '../assets/doodle-writing.svg?raw';
import projects from '../assets/doodle-projects.svg?raw';
import { withPlanet } from '../scripts/planet';

interface Props {
  art?: 'writing' | 'projects';
}
const { art } = Astro.props;
const id = `sk-${art}`;
function sketch(raw: string) {
  const [, open, body] = raw.match(/^(<svg[^>]*>)([\s\S]*)<\/svg>\s*$/)!;
  const ink = body.replace(/(id="|url\(#)([\w-]+)/g, '$1$2-ink');
  return `${open}<clipPath id="${id}"><path class="blob"></path></clipPath><path class="blob jelly"></path><g class="rest">${body}</g><g class="ink" clip-path="url(#${id})">${ink}</g></svg>`;
}
const svg = art ? sketch({ writing, projects }[art]) : withPlanet(doodle);
---

<Fragment set:html={svg} />

<script>
  import { BANDS, bandPath } from '../scripts/planet';
  import { trail } from '../scripts/blob';
  // A section doodle is inked under the blob that trails a mouse over its box: the clip path and the faint jelly share it.
  document
    .querySelectorAll<SVGSVGElement>('.sketch')
    .forEach((s) => trail(s.parentElement!, s, [...s.querySelectorAll('.blob')], 270));
  // The bands turn with the planet: projected each frame, only while the doodle is on screen and the splash is not
  // covering it. Time only runs while it does, so nothing jumps. Off screen the svg is also `.idle`, which pauses the
  // CSS loops (the rings and the pendulum).
  const root = document.documentElement;
  const paths = [...document.querySelectorAll<SVGPathElement>('[data-band]')];
  const svg = paths[0]?.ownerSVGElement;
  if (svg && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let raf = 0, last = 0, t = 0, seen = false;
    const tick = (now: number) => {
      if (last) t += (now - last) / 1000;
      last = now;
      paths.forEach((p, i) => p.setAttribute('d', bandPath(BANDS[i], t)));
      raf = requestAnimationFrame(tick);
    };
    const sync = () => {
      const go = seen && !root.classList.contains('splash');
      if (go && !raf) raf = requestAnimationFrame(tick);
      if (!go && raf) {
        cancelAnimationFrame(raf);
        raf = last = 0;
      }
    };
    new IntersectionObserver(([e]) => {
      seen = e.isIntersecting;
      svg.classList.toggle('idle', !seen);
      sync();
    }).observe(svg);
    new MutationObserver(sync).observe(root, { attributes: true, attributeFilter: ['class'] });
  }
</script>

<style is:global>
  .doodle {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
    color: var(--ink);
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    /* stroke widths scale with the drawing; the phone band thickens them */
    --k: 1;
  }
  .doodle circle { fill: currentColor; stroke: none; }
  .doodle .fill { fill: var(--spot); stroke: none; }
  .doodle .flame { fill: var(--logo); }
  .doodle .tone { fill: currentColor; fill-opacity: 0.22; stroke: none; }
  .doodle .body { fill: var(--bg); }
  .doodle .w2 { stroke-width: calc(2px * var(--k)); }
  .doodle .w25 { stroke-width: calc(2.5px * var(--k)); }
  .doodle .w35 { stroke-width: calc(3.5px * var(--k)); }
  .doodle .w45 { stroke-width: calc(4.5px * var(--k)); }
  .doodle .w55 { stroke-width: calc(5.5px * var(--k)); }
  .doodle .w10 { stroke-width: calc(10px * var(--k)); }

  /* Strokes draw on (pathLength 1), dots and stars pop in, the flame fills in and the rocket lifts: once, fill mode
     backwards, so each ends in its plain state. Then two things keep moving: the rings orbit (their dashes, inner
     ringlets faster) and the pendulum swings between its drawn extremes. Both hold still while the doodle is off
     screen (`.idle`, set by the script above). */
  @media (prefers-reduced-motion: no-preference) {
    .doodle [pathLength] { animation: d-draw calc(var(--t) * 1ms) var(--ease) calc(var(--d) * 1ms) backwards; }
    .doodle circle,
    .doodle .star { animation: d-pop 450ms var(--ease) calc(var(--d) * 1ms) backwards; transform-box: fill-box; transform-origin: center; }
    .doodle .star * { animation: none; }
    .doodle .rings,
    .doodle .bands { animation: d-fade 900ms var(--ease) 1250ms backwards; }
    .doodle .ring { animation: d-orbit calc(var(--ms) * 1ms) linear infinite; }
    .doodle .swing { animation: d-swing 1100ms cubic-bezier(0.37, 0, 0.63, 1) 1750ms infinite alternate; transform-box: view-box; transform-origin: 760px 799px; }
    .doodle .rocket { animation: d-lift 750ms var(--ease) 1950ms backwards; }
    .doodle .flame { animation: d-pop 450ms var(--ease) 1950ms backwards; transform-box: fill-box; transform-origin: 72% 4%; }
    /* Held at the start while the splash plays; it runs once the content rises (html.go). */
    html.splash:not(.go) .doodle,
    html.splash:not(.go) .doodle * { animation-play-state: paused; }
    .doodle.idle .ring,
    .doodle.idle .swing { animation-play-state: paused; }
    /* The section doodles don't draw on: they rest as a pencil sketch and the blob is their moment. While the svg is
       hovered, their parts loop on their own clocks (sections.mjs rigs them): slow and small. Off hover every loop
       holds where it is. */
    .doodle.sketch circle,
    .doodle.sketch [pathLength] { animation: none; }
    .doodle.sketch .glow { animation: sk-glow 1.8s ease-in-out infinite alternate; }
    .doodle.sketch .bob { animation: sk-bob 2.4s ease-in-out var(--dl, 0s) infinite alternate; }
    .doodle.sketch .twinkle { transform-box: fill-box; transform-origin: center; animation: sk-twinkle 2.2s ease-in-out var(--dl) infinite alternate; }
    /* Writing: the pen writes the four rows in turn, lifts off, the full page tears away and a blank one settles. */
    .doodle.sketch .pen { animation: sk-pen 12s linear infinite; }
    .doodle.sketch .page { transform-box: fill-box; transform-origin: 50% 0; animation: sk-page 12s var(--ease) infinite; }
    .doodle.sketch .row { stroke-dasharray: 1; animation: 12s linear infinite; }
    .doodle.sketch .r0 { animation-name: sk-r0; }
    .doodle.sketch .r1 { animation-name: sk-r1; }
    .doodle.sketch .r2 { animation-name: sk-r2; }
    .doodle.sketch .r3 { animation-name: sk-r3; }
    .doodle.sketch .scroll { animation: sk-scroll 16s linear infinite; }
    /* Projects: the gears turn (the small one faster, the other way), the flask simmers, the tag sways. */
    .doodle.sketch .spin { transform-box: view-box; animation: sk-spin var(--p) linear infinite; }
    .doodle.sketch .ccw { animation-direction: reverse; }
    .doodle.sketch .slosh { transform-box: fill-box; transform-origin: center; animation: sk-slosh 1.6s ease-in-out infinite alternate; }
    .doodle.sketch .boil { transform-box: fill-box; transform-origin: center; animation: sk-boil var(--dur) ease-in var(--dl) infinite; }
    .doodle.sketch .rise { transform-box: fill-box; transform-origin: center; animation: sk-rise 3.6s linear var(--dl) infinite; }
    .doodle.sketch .sway { transform-box: view-box; animation: sk-sway 2.6s ease-in-out infinite alternate; }
    .doodle.sketch .whoosh { animation: sk-whoosh 1.8s var(--ease) var(--dl) infinite; }
    .doodle.sketch:not(:hover) * { animation-play-state: paused; }
  }
  .doodle .jelly { fill: var(--line); stroke: none; }
  /* A section doodle: the sketch at rest in --muted, the blob's copy in --ink. */
  .doodle.sketch { color: var(--muted); }
  .doodle.sketch .ink { color: var(--ink); }
  @keyframes sk-glow { to { opacity: 0.3; } }
  @keyframes sk-bob { to { transform: translateY(-5px); } }
  @keyframes sk-twinkle { to { opacity: 0.35; transform: scale(0.55); } }
  @keyframes sk-pen {
    0%, 2% { transform: translate(var(--s0)); }
    15% { transform: translate(var(--e0)); }
    19% { transform: translate(var(--s1)); }
    32% { transform: translate(var(--e1)); }
    36% { transform: translate(var(--s2)); }
    49% { transform: translate(var(--e2)); }
    53% { transform: translate(var(--s3)); }
    66% { transform: translate(var(--e3)); }
    70%, 86% { transform: translate(var(--lift)); animation-timing-function: var(--ease); }
    100% { transform: translate(var(--s0)); }
  }
  @keyframes sk-page {
    0%, 70% { transform: none; opacity: 1; }
    75% { transform: translate(-6px, -16px) rotate(-4deg); opacity: 0; }
    75.5% { transform: translateY(10px); opacity: 0; }
    84%, 100% { transform: none; opacity: 1; }
  }
  @keyframes sk-r0 { 0%, 2% { stroke-dashoffset: 1; } 15%, 75% { stroke-dashoffset: 0; } 75.5%, 100% { stroke-dashoffset: 1; } }
  @keyframes sk-r1 { 0%, 19% { stroke-dashoffset: 1; } 32%, 75% { stroke-dashoffset: 0; } 75.5%, 100% { stroke-dashoffset: 1; } }
  @keyframes sk-r2 { 0%, 36% { stroke-dashoffset: 1; } 49%, 75% { stroke-dashoffset: 0; } 75.5%, 100% { stroke-dashoffset: 1; } }
  @keyframes sk-r3 { 0%, 53% { stroke-dashoffset: 1; } 66%, 75% { stroke-dashoffset: 0; } 75.5%, 100% { stroke-dashoffset: 1; } }
  @keyframes sk-scroll { to { transform: translate(var(--page)); } }
  @keyframes sk-spin { to { transform: rotate(1turn); } }
  @keyframes sk-slosh { to { transform: scaleY(-0.5); } }
  @keyframes sk-boil {
    0% { transform: translateY(0) scale(0.4); opacity: 0; }
    15% { transform: translateY(0) scale(1); opacity: 1; }
    85% { opacity: 1; }
    100% { transform: translateY(var(--rise)) scale(1.15); opacity: 0; }
  }
  @keyframes sk-rise {
    0% { transform: translateY(var(--a)) scale(0.5); opacity: 0; }
    20%, 75% { opacity: 1; }
    100% { transform: translateY(var(--b)) scale(1); opacity: 0; }
  }
  @keyframes sk-sway { from { transform: rotate(-4deg); } to { transform: rotate(4deg); } }
  @keyframes sk-whoosh {
    0% { transform: translate(0, 0); opacity: 1; }
    55% { transform: translate(var(--w)); opacity: 0; }
    56% { transform: translate(0, 0); opacity: 0; }
    100% { transform: translate(0, 0); opacity: 1; }
  }
  @keyframes d-draw { from { stroke-dasharray: 1; stroke-dashoffset: 1; visibility: hidden; } to { stroke-dasharray: 1; stroke-dashoffset: 0; } }
  @keyframes d-pop { from { opacity: 0; transform: scale(0.2); } }
  @keyframes d-fade { from { opacity: 0; } }
  @keyframes d-orbit { to { stroke-dashoffset: var(--shift); } }
  @keyframes d-swing { to { transform: rotate(-55deg); } }
  @keyframes d-lift { from { transform: translate(-7px, 11px); } }
</style>
