---
/** This site as the featured case study: one line of what it is, three facts, and links to the write-up and source. */
interface Props {
  level?: 'h2' | 'h3';
}
const { level: Title = 'h3' } = Astro.props;

const facts = [
  {
    term: 'Rendering',
    text: 'Every page is static HTML. React hydrates two islands: the ⌘K search and the planet.',
  },
  {
    term: 'The planet',
    text: 'A dithered point cloud in React Three Fiber, loaded after idle and capped at 30fps. Without WebGL, a CSS drawing stands in.',
  },
  {
    term: 'Easter eggs',
    text: "Six of them. Some sit at coordinates on the home page, and the cursor readout tells you when you're close.",
  },
];
---

<article class="hud case-study">
  <div class="case-study__intro">
    <Title class="case-study__title">This site</Title>
    <p class="case-study__summary">
      A static Astro site with a pixel-type interface and a WebGL planet that loads after everything else.
    </p>
    <p class="label case-study__links">
      <a href="/writing/rebuilding-this-site" class="link tap">How it was built <span aria-hidden="true">→</span></a>
      <a href="https://github.com/thoughtlessmind/thoughtlessmind" class="link tap" rel="noopener" target="_blank">
        Source <span aria-hidden="true">↗</span>
      </a>
    </p>
  </div>

  <dl class="case-study__facts">
    {
      facts.map((f) => (
        <div>
          <dt>{f.term}</dt>
          <dd>{f.text}</dd>
        </div>
      ))
    }
  </dl>
</article>

<style>
  .case-study {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem;
    padding: clamp(1.5rem, 3vw, 2.5rem);
  }
  .case-study__title {
    font-size: var(--text-h3);
    line-height: var(--text-h3--line-height);
    letter-spacing: -0.01em;
  }
  .case-study__summary {
    max-width: 44ch;
    margin-top: 0.75rem;
    color: var(--text-muted);
  }
  .case-study__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.5rem;
    margin-top: 1.5rem;
  }
  .case-study__links a {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
  }

  .case-study__facts {
    display: grid;
    gap: 1.25rem;
    margin: 0;
  }
  .case-study__facts dt {
    font-weight: 600;
  }
  .case-study__facts dd {
    margin: 0.25rem 0 0;
    font-size: var(--text-small);
    color: var(--text-muted);
  }

  @media (min-width: 1024px) {
    .case-study {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: clamp(2rem, 5vw, 4rem);
    }
  }
</style>
