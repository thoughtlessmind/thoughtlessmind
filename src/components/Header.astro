---
import { SITE } from '../consts';
import ThemeToggle from './ThemeToggle.astro';

export interface Props {
  /** The section the page belongs to: its nav link gets aria-current="page" and the underline. */
  current?: 'blogs';
  /** A reading-progress line along the header's bottom edge (post pages). */
  progress?: boolean;
}
const { current, progress = false } = Astro.props;
// `.rise` + `--d` (ms) are the splash's hooks: the splash staggers them in. No CSS here hides or animates them.
// The home page's scroll spy sets aria-current="true" on one of the `[data-spy]` links; the underline follows it.
---

<div class="dock">
<header class="top wrap" data-progress={progress ? '' : undefined}>
  <a class="name" href="/" aria-label={`${SITE.name}, home`}>
    <svg class="mark" data-logo viewBox="-2.01 0 30 30" fill="#ff5f1f" aria-hidden="true"><path d="M8.66 5 17.32 10v10l-8.66 5L0 20V10z" fill-opacity=".45"></path><path d="M17.32 10l8.66 5v10l-8.66 5-8.66-5V15z" fill-opacity=".65"></path><path d="M17.32 0l8.66 5v10l-8.66 5-8.66-5V5z" fill-opacity=".8"></path></svg>
    <span class="sig" aria-hidden="true">{SITE.name}</span>
  </a>
  <div class="bar">
    <nav aria-label="Main">
      {
        SITE.nav.map((item, i) => (
          <a
            class="rise"
            style={`--d:${60 + i * 40}`}
            href={item.href}
            data-spy={item.spy}
            aria-current={current === item.spy ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
      <span class="nav-line" aria-hidden="true"></span>
    </nav>
    <div class="reach">
      <a class="x rise" style="--d:160" href={SITE.socials.x} rel="noopener" target="_blank" aria-label="Rajiv on X (opens in a new tab)">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.75 3h3.07l-6.7 7.66L22 21h-6.17l-4.83-6.32L5.47 21H2.4l7.17-8.2L2 3h6.33l4.37 5.78zm-1.08 16.18h1.7L7.4 4.73H5.58z"></path></svg>
      </a>
      <button class="hi rise" style="--d:170" type="button" popovertarget="say-hi" aria-haspopup="dialog">Say hi</button>
      <div class="hi-pop" id="say-hi" popover role="dialog" aria-label="Ways to reach Rajiv">
        <p class="hi-head">Write to me wherever suits you.</p>
        <ul>
          <li class="hi-mail">
            <a href={`mailto:${SITE.email}`}><span>Email</span><span class="hi-sub">{SITE.email}</span></a>
            <button type="button" class="hi-copy" data-copy={SITE.email} aria-live="polite">Copy</button>
          </li>
          <li><a href={SITE.socials.linkedin} rel="noopener" target="_blank"><span>LinkedIn</span><span class="hi-sub">Message me</span><span class="sr-only"> (opens in a new tab)</span></a></li>
          <li><a href={SITE.socials.x} rel="noopener" target="_blank"><span>X</span><span class="hi-sub">@{SITE.socials.x.split('/').pop()}</span><span class="sr-only"> (opens in a new tab)</span></a></li>
        </ul>
      </div>
    </div>
    <ThemeToggle />
  </div>
</header>
</div>
<div class="top-at" data-top-at aria-hidden="true"></div>

<script>
  // The header lifts on scroll through a CSS scroll-driven animation (global.css). Where `animation-timeline` is
  // missing, a 1px sentinel 60px down the page sets html.lifted once it has scrolled out of view.
  const at = document.querySelector('[data-top-at]');
  if (at && !CSS.supports('animation-timeline: scroll()'))
    new IntersectionObserver(([e]) => document.documentElement.classList.toggle('lifted', !e.isIntersecting)).observe(at);

  // The name beside the logo (DESIGN.md §3): on the home page it writes itself in once the hero's name has scrolled up
  // under the header, and wipes out when it comes back, so the name is never on screen twice. Pages without the hero
  // name show it from the start, with no animation.
  const top = document.querySelector<HTMLElement>('.top');
  const hero = document.querySelector('[data-hero-name]');
  if (top && !hero) top.dataset.named = 'still';
  if (top && hero)
    new IntersectionObserver(
      ([e]) => {
        const gone = !e.isIntersecting && e.boundingClientRect.top < e.rootBounds!.top;
        if (gone) top.dataset.named = '';
        else delete top.dataset.named;
      },
      { rootMargin: `-${top.offsetHeight}px 0px 0px 0px` },
    ).observe(hero);

  // The current link's underline: measured from the link (labels differ in width) and slid there by a CSS transition.
  // It moves when aria-current changes (the home page's scroll spy, or the page's own link), when the nav resizes and
  // once the fonts have loaded. No scroll listener, no loop.
  const nav = document.querySelector<HTMLElement>('.top nav');
  const line = nav?.querySelector<HTMLElement>('.nav-line');
  if (nav && line) {
    const place = () => {
      const a = nav.querySelector<HTMLElement>('a[aria-current]');
      line.classList.toggle('shown', !!a);
      if (a) line.style.transform = `translateX(${a.offsetLeft + (a.offsetWidth - line.offsetWidth) / 2}px)`;
    };
    place();
    // The first placement doesn't slide in from the left edge.
    line.getBoundingClientRect();
    line.classList.add('ready');
    new MutationObserver(place).observe(nav, { subtree: true, attributeFilter: ['aria-current'] });
    new ResizeObserver(place).observe(nav);
    document.fonts.ready.then(place);
  }

  // The logo on the home page scrolls back to the top instead of reloading. Elsewhere it is a plain link home, and a
  // modified click (new tab, new window) is left to the browser.
  document.querySelector<HTMLAnchorElement>('.top .name')?.addEventListener('click', (e) => {
    if (location.pathname !== '/' || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button !== 0) return;
    e.preventDefault();
    if (location.hash) history.replaceState(null, '', '/');
    scrollTo({ top: 0 });
  });

  // Say hi: a native popover (light dismiss and Esc for free). Copy puts the address on the clipboard and says so.
  document.querySelectorAll<HTMLButtonElement>('.hi-copy').forEach((b) =>
    b.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(b.dataset.copy!);
        b.textContent = 'Copied';
        setTimeout(() => (b.textContent = 'Copy'), 1600);
      } catch {}
    }),
  );
</script>
