---
/**
 * Big Geist Pixel numbers in a 2 x 2 grid (pass four). The final value is in the HTML; fx.ts rolls the digits
 * when in view. `value` is the digit string as shown, `suffix` follows it ("k+").
 */
interface Props {
  items: { value: string; suffix?: string; label: string }[];
  class?: string;
}
const { items, class: className } = Astro.props;
---

<ul class:list={['counters', className]}>
  {
    items.map((i) => (
      <li class="counters__item">
        <span class="counters__value" data-count-to={i.value} data-count-suffix={i.suffix}>
          {`${i.value}${i.suffix ?? ''}`}
        </span>
        <span class="counters__label">{i.label}</span>
      </li>
    ))
  }
</ul>

<style>
  .counters {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .counters__item {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding-left: 1rem;
    border-left: 2px solid var(--border-strong);
  }
  .counters__value {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 1.5rem + 3vw, 4rem);
    line-height: 1;
    font-variant-numeric: tabular-nums;
    color: var(--text);
  }
  .counters__label {
    font-size: var(--text-small);
    color: var(--text-muted);
  }
</style>
