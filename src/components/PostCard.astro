---
// One post as a row: the title, summary, then the date and reading time on the left, the doodle cover on the right (or
// its line of code, set large, when it has no cover yet). Used by the home page and a post's "More blogs". The
// cover carries a view-transition-name, so it morphs into the post's own cover on navigation.
import { cover, iso, minutes, month, type Post } from '../lib/blogs';

interface Props {
  post: Post;
  /** The cover in the shared right-hand column (`--media`, 2:1) from 721px: the home page and "More blogs". */
  wide?: boolean;
}
const { post, wide = false } = Astro.props;
const { title, description, date, code } = post.data;
const art = cover(post.id);
---

<a class:list={['post', { wide }]} href={`/blogs/${post.id}`}>
  <span class="pc">
    <span class="pt">{title}</span>
    <span class="cs">{description}</span>
    <span class="pm"><time datetime={iso(date)}>{month(date)}</time> · {minutes(post.body)} min read</span>
  </span>
  {
    art ? (
      <span class="cover" style={`view-transition-name: cover-${post.id}`} aria-hidden="true" set:html={art} />
    ) : (
      <span class="cover cover-code" style={`view-transition-name: cover-${post.id}`} aria-hidden="true">
        <code>{code}</code>
      </span>
    )
  }
</a>

<style>
  .post {
    display: grid;
    grid-template-columns: minmax(0, 1fr) clamp(112px, 9vw, 136px);
    gap: 32px;
    align-items: start;
    padding-block: 24px;
    border-top: 1px solid var(--line);
  }
  .pm {
    display: block;
    margin-top: 14px;
    font-size: var(--t-xs);
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .pt {
    display: block;
    font-size: var(--t-sm);
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: -0.015em;
    text-wrap: balance;
    transition: color 200ms var(--ease);
  }
  @media (hover: hover) {
    .post:hover .pt {
      color: var(--accent);
    }
  }
  .post:focus-visible .pt {
    color: var(--accent);
  }
  .cs {
    display: block;
    max-width: 36em;
    margin-top: 8px;
    color: var(--muted);
    text-wrap: pretty;
  }
  .cover {
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border: 1px solid var(--frame);
  }
  /* The drawings fill at most 70% of their frame; at 1.25 they keep a thin margin in the small cover. */
  .cover :global(svg) {
    width: 100%;
    height: 100%;
    scale: 1.25;
    color: var(--ink);
  }
  .cover :global(.o) {
    fill: var(--spot);
  }
  .cover-code code {
    max-width: 86%;
    font-family: var(--mono);
    font-size: var(--t-code);
    line-height: 1.5;
    color: var(--ink);
    text-align: center;
    text-wrap: balance;
    overflow-wrap: anywhere;
  }
  /* Press: the cover gives a little under the finger and the title takes the accent (a colour on :active does not
     stick after a tap). */
  .post:active .pt {
    color: var(--accent);
  }
  @media (prefers-reduced-motion: no-preference) {
    .cover {
      transition: transform 160ms var(--ease);
    }
    .post:active .cover {
      transform: scale(0.97);
    }
    .cover :global(svg),
    .cover-code code {
      transition: transform 800ms var(--ease);
    }
  }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .post:hover .cover :global(svg),
    .post:hover .cover-code code {
      transform: scale(1.03);
    }
  }
  /* Wide: the cover takes the shared right-hand column at 2:1, so the row stays about as tall as its text. */
  @media (min-width: 721px) {
    .wide {
      grid-template-columns: minmax(0, 1fr) var(--media);
      gap: 48px;
    }
    .wide .cover {
      aspect-ratio: 2 / 1;
    }
  }
  /* Phone: the cover shrinks to a thumbnail beside the title only; the summary and date run the full width under
     them, so the summary keeps a readable line. */
  @media (max-width: 720px) {
    .post {
      grid-template-columns: minmax(0, 1fr) 80px;
      grid-template-areas: "t c" "s s" "m m";
      gap: 0 16px;
    }
    .pc {
      display: contents;
    }
    .pt {
      grid-area: t;
      align-self: center;
    }
    .cs {
      grid-area: s;
    }
    .pm {
      grid-area: m;
    }
    .cover {
      grid-area: c;
    }
    .cover-code code {
      font-size: 9px;
    }
  }
</style>
