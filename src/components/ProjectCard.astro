---
/**
 * Card for a featured project: kind and year, title, summary, stack tags, links, and a real visual where there is one.
 * - A screenshot (`image` in the frontmatter) spans both grid columns (`.project-card--wide`) so the grid stays even.
 * - css-only-tooltip shows the library's own technique working (the .demo plate in global.css).
 */
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';

interface Props {
  project: CollectionEntry<'projects'>;
  /** h3 under a section h2. */
  level?: 'h2' | 'h3';
  /** Also show the longer description (the /work page). */
  long?: boolean;
  class?: string;
}
const { project, level: Title = 'h3', long = false, class: className } = Astro.props;
const { title, summary, description, year, kind, stack, repo, live, image } = project.data;
const liveLabel = project.id === 'css-only-tooltip' ? 'npm' : project.id === 'diver' ? 'Web store' : 'Live';
const tooltip = project.id === 'css-only-tooltip';
---

<li class:list={['hud project-card', { 'project-card--wide': image }, className]}>
  {
    image && (
      <div class="project-card__media">
        <Image src={image} alt={`Screenshot of ${title}`} width={680} densities={[1, 2]} loading="lazy" decoding="async" />
      </div>
    )
  }
  {
    tooltip && (
      <div class="demo project-card__demo" aria-hidden="true">
        <span data-tooltip="Pure CSS. No JavaScript.">data-tooltip</span>
      </div>
    )
  }

  <div class="project-card__body">
    <Title class="project-card__title">
      <a href={live ?? repo} class="project-card__link tap" rel="noopener" target="_blank">{title}</a>
    </Title>
    <p class="project-card__summary">{summary}</p>
    {long && <p class="project-card__desc">{description}</p>}
    <ul class="project-card__tags" aria-label="Stack">
      {stack.map((s) => <li class="tag">{s}</li>)}
    </ul>
    <p class="label project-card__links">
      {
        repo && (
          <a href={repo} class="link tap" rel="noopener" target="_blank">
            Repo <span aria-hidden="true">↗</span>
          </a>
        )
      }
      {
        live && (
          <a href={live} class="link tap" rel="noopener" target="_blank">
            {liveLabel} <span aria-hidden="true">↗</span>
          </a>
        )
      }
      <span class="project-card__year">{kind}, {year}</span>
    </p>
  </div>
</li>

<style>
  .project-card {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-content: start;
    list-style: none;
  }
  .project-card__body {
    display: flex;
    flex-direction: column;
    padding: 1.5rem;
  }
  .project-card__year {
    margin-left: auto;
  }
  /* Same size whether it renders as h3 (home) or h2 (/work). */
  .project-card__title {
    font-size: var(--text-h3);
    line-height: var(--text-h3--line-height);
    letter-spacing: -0.01em;
  }
  .project-card__link {
    color: inherit;
    text-decoration: none;
  }
  .project-card__link:hover,
  .project-card__link:focus-visible {
    color: var(--accent);
  }
  .project-card__summary {
    margin-top: 0.5rem;
    color: var(--text);
  }
  .project-card__desc {
    margin-top: 0.75rem;
    font-size: var(--text-small);
    color: var(--text-muted);
  }
  .project-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1.25rem 0 0;
    padding: 0;
    list-style: none;
  }
  .project-card__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.5rem;
    margin-top: auto;
    padding-top: 1rem;
  }
  .project-card__links a {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
  }

  .project-card__media {
    overflow: hidden;
    aspect-ratio: 16 / 10;
    border-bottom: 1px solid var(--border);
    background: var(--surface);
  }
  .project-card__media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top left;
  }

  /* The tooltip plate: a short band above the body, tooltip text hanging below its target. */
  .project-card__demo {
    padding: 1.75rem 1.5rem 3.25rem;
    border: 0;
    border-bottom: 1px solid var(--border);
  }

  @media (min-width: 720px) {
    .project-card--wide {
      grid-column: 1 / -1;
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    }
    .project-card--wide .project-card__media {
      aspect-ratio: auto;
      min-height: 18rem;
      border-bottom: 0;
      border-right: 1px solid var(--border);
    }
  }
</style>
