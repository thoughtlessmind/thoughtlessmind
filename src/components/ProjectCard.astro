---
/**
 * Module card for a featured project: `M-01` + year, glitching title, summary, stack tags, links.
 * A screenshot (when the project has one) sits behind a duotone + dither + scanline wash that clears on hover/focus.
 * Cards with an image span both grid columns (`.project-card--wide`) so the grid stays even.
 */
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';

interface Props {
  project: CollectionEntry<'projects'>;
  /** 1-based position, rendered as M-01. */
  index: number;
  /** h3 under a section h2. */
  level?: 'h2' | 'h3';
  /** Also show the longer description (the /work page). */
  long?: boolean;
  class?: string;
}
const { project, index, level: Title = 'h3', long = false, class: className } = Astro.props;
const { title, summary, description, year, stack, repo, live, image } = project.data;
const liveLabel = project.id === 'css-only-tooltip' ? 'npm' : project.id === 'diver' ? 'Web store' : 'Live';
const id = `M-${String(index).padStart(2, '0')}`;
---

<li class:list={['hud project-card', { 'project-card--wide': image }, className]}>
  {
    image && (
      <div class="project-card__media">
        <Image src={image} alt={`Screenshot of ${title}`} width={680} densities={[1, 2]} loading="lazy" decoding="async" />
      </div>
    )
  }

  <div class="project-card__body">
    <p class="label project-card__meta">
      <span class="project-card__id">{id}</span>
      <span>{year}</span>
    </p>
    <Title class="glitch project-card__title" data-text={title}>
      <a href={live ?? repo} class="project-card__link tap" rel="noopener" target="_blank">{title}</a>
    </Title>
    <p class="project-card__summary">{summary}</p>
    {long && <p class="project-card__desc">{description}</p>}
    <ul class="project-card__tags" aria-label="Stack">
      {stack.map((s) => <li class="tag">{s}</li>)}
    </ul>
    <p class="label project-card__links">
      {
        repo && (
          <a href={repo} class="link tap" rel="noopener" target="_blank">
            Repo <span aria-hidden="true">↗</span>
          </a>
        )
      }
      {
        live && (
          <a href={live} class="link tap" rel="noopener" target="_blank">
            {liveLabel} <span aria-hidden="true">↗</span>
          </a>
        )
      }
    </p>
  </div>
</li>

<style>
  .project-card {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-content: start;
    list-style: none;
  }
  .project-card__body {
    display: flex;
    flex-direction: column;
    padding: 1.5rem;
  }
  .project-card__meta {
    display: flex;
    justify-content: space-between;
    margin: 0;
    color: var(--text-subtle);
  }
  .project-card__id {
    color: var(--accent);
  }
  .project-card__title {
    margin-top: 1.25rem;
    font-family: var(--font-ui);
    font-size: var(--text-h3);
    font-weight: 500;
  }
  .project-card__link {
    color: inherit;
    text-decoration: none;
  }
  .project-card__link:hover,
  .project-card__link:focus-visible {
    color: var(--accent);
  }
  .project-card__summary {
    margin-top: 0.75rem;
    color: var(--text);
  }
  .project-card__desc {
    margin-top: 0.75rem;
    font-size: var(--text-small);
    color: var(--text-muted);
  }
  .project-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1.25rem 0 0;
    padding: 0;
    list-style: none;
  }
  .project-card__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.5rem;
    margin-top: auto;
    padding-top: 1rem;
  }
  .project-card__links a {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
  }

  /* Screenshot: duotone (grayscale under an accent multiply), dither dots and scanlines; clears on hover/focus. */
  .project-card__media {
    position: relative;
    overflow: hidden;
    aspect-ratio: 16 / 10;
    border-bottom: 1px solid var(--border);
    background: var(--surface);
  }
  .project-card__media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top left;
    filter: grayscale(1) contrast(1.15);
    transition: filter var(--dur-3) var(--ease-out);
  }
  .project-card__media::before,
  .project-card__media::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    transition: opacity var(--dur-3) var(--ease-out);
  }
  .project-card__media::before {
    background: var(--accent);
    mix-blend-mode: multiply;
    opacity: 0.55;
  }
  .project-card__media::after {
    background-image:
      radial-gradient(var(--bg) 0.6px, transparent 0.8px),
      repeating-linear-gradient(to bottom, transparent 0 2px, var(--bg) 2px 3px);
    background-size: 3px 3px, 100% 3px;
    opacity: 0.45;
  }
  .project-card:hover .project-card__media :global(img),
  .project-card:focus-within .project-card__media :global(img) {
    filter: none;
  }
  .project-card:hover .project-card__media::before,
  .project-card:hover .project-card__media::after,
  .project-card:focus-within .project-card__media::before,
  .project-card:focus-within .project-card__media::after {
    opacity: 0;
  }

  @media (min-width: 720px) {
    .project-card--wide {
      grid-column: 1 / -1;
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    }
    .project-card--wide .project-card__media {
      aspect-ratio: auto;
      min-height: 18rem;
      border-bottom: 0;
      border-right: 1px solid var(--border);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .project-card__media :global(img),
    .project-card__media::before,
    .project-card__media::after {
      transition: none;
    }
  }
</style>
