---
/** Tag filters: `all 10`, `css 2`… as chips with a count. Wraps on desktop; one scrolling row on phones. */
interface Props {
  tags: { tag: string; count: number }[];
  /** 'all', a tag name, or '' for none. */
  active: string;
  /** Articles listed on this page. */
  total: number;
  /** Count shown on the "all" chip. Defaults to `total`. */
  allCount?: number;
  class?: string;
}
const { tags, active, total, allCount = total, class: className } = Astro.props;
const chips = [{ tag: 'all', count: allCount, href: '/writing' }, ...tags.map((t) => ({ ...t, href: `/writing/tag/${t.tag}` }))];
---

<div class:list={['tag-chips', className]}>
  <nav aria-label="Filter by tag">
    <ul class="chip-row">
      {
        chips.map(({ tag, count, href }) => (
          <li>
            <a href={href} class="chip" aria-current={active === tag ? 'page' : undefined}>
              <span>{tag}</span>
              <span class="chip__count">{count}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</div>

<style>
  .tag-chips {
    padding-bottom: 2.5rem;
  }
  .chip-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.25rem;
    padding-inline: 0.75rem;
    border: 1px solid var(--border);
    font-family: var(--font-ui);
    font-size: var(--text-caption);
    color: var(--text-muted);
    text-decoration: none;
    white-space: nowrap;
    transition:
      color var(--dur-1) var(--ease-out),
      border-color var(--dur-1) var(--ease-out),
      background-color var(--dur-1) var(--ease-out);
  }
  .chip__count {
    color: var(--text-subtle);
    font-variant-numeric: tabular-nums;
  }
  .chip:hover {
    color: var(--text);
    border-color: var(--border-strong);
    background: var(--surface);
  }
  .chip[aria-current='page'] {
    color: var(--accent);
    border-color: var(--accent);
    background: var(--accent-soft);
  }
  .chip[aria-current='page'] .chip__count {
    color: inherit;
  }
  /* Phones: one row that scrolls inside itself (edge to edge), so the listing stays above the fold. */
  @media (max-width: 640px) {
    .chip-row {
      flex-wrap: nowrap;
      overflow-x: auto;
      scrollbar-width: none;
      margin-inline: calc(-1 * var(--spacing-gutter));
      padding-inline: var(--spacing-gutter);
    }
  }
</style>
