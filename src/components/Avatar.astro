---
/**
 * Square avatar in a frame with a dithered scan overlay. Uses /images/avatar.{jpg,png,webp} when present
 * (grayscale + dither), else the initials "RK". At 96px and up it gets the HUD corner brackets, the pixel
 * display face and a slow scan bar; small sizes (bylines) stay plain. Props stay stable: size (px), class.
 */
import { SITE } from '../consts';

interface Props {
  /** Pixel size of the square. */
  size?: number;
  class?: string;
}
const { size = 64, class: className } = Astro.props;
const large = size >= 96;
// Resolved by Vite from the project root, so it does not depend on the build's cwd.
const src = Object.keys(import.meta.glob('/public/images/avatar.{jpg,png,webp}'))[0]?.replace(/^\/public/, '') ?? null;
---

<span
  class:list={['avatar', { 'hud avatar--lg': large }, className]}
  style={`--size:${size}px`}
  aria-hidden={src ? undefined : 'true'}
>
  {
    src ? (
      <img class="avatar__face" src={src} alt={SITE.name} width={size} height={size} loading="lazy" decoding="async" />
    ) : (
      <span class="avatar__face avatar__initials">RK</span>
    )
  }
</span>

<style>
  .avatar {
    position: relative;
    display: inline-grid;
    place-items: center;
    width: var(--size);
    height: var(--size);
    flex-shrink: 0;
    overflow: hidden;
    border: 1px solid var(--border-strong);
    background: var(--surface);
  }
  .avatar--lg {
    overflow: visible;
    border-color: var(--border);
  }
  .avatar__face {
    width: 100%;
    height: 100%;
  }
  img.avatar__face {
    object-fit: cover;
    filter: grayscale(1) contrast(1.2);
  }
  .avatar__initials {
    display: grid;
    place-items: center;
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: calc(var(--size) * 0.36);
    line-height: 1;
    color: var(--text);
  }
  .avatar--lg .avatar__initials {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: calc(var(--size) * 0.42);
  }

  /* Dither dots + scanlines over the face. */
  .avatar::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image:
      radial-gradient(var(--bg) 0.6px, transparent 0.8px),
      repeating-linear-gradient(to bottom, transparent 0 2px, var(--bg) 2px 3px);
    background-size: 3px 3px, 100% 3px;
    opacity: 0.35;
  }

  /* Large only: an accent scan bar sweeping top to bottom. */
  .avatar--lg .avatar__face {
    position: relative;
    overflow: hidden;
  }
  .avatar--lg .avatar__face::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 18%;
    background: linear-gradient(to bottom, transparent, var(--accent-soft), transparent);
    animation: avatar-scan calc(var(--dur-4) * 4) linear infinite;
  }
  @keyframes avatar-scan {
    from {
      transform: translateY(-100%);
    }
    to {
      transform: translateY(560%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .avatar--lg .avatar__face::before {
      animation: none;
      display: none;
    }
  }
</style>
