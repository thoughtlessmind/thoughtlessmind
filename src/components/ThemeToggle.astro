---
// One sun that morphs into a moon (DESIGN.md §3, §4), drawn in Phosphor's regular weight. The moon is the orb grown,
// with a shade circle slid in from the top right: the mask cuts the orb's outline where the shade covers it and the
// shade's own outline, clipped to the orb, closes the crescent. The rays spin away into the middle.
---
<button class="theme rise" style="--d:180" type="button" aria-label="Switch to light theme" data-theme-toggle>
  <svg viewBox="0 0 256 256" fill="none" stroke="currentColor" stroke-width="16" stroke-linecap="round" aria-hidden="true" focusable="false">
    <mask id="sm-cut" maskUnits="userSpaceOnUse">
      <rect width="256" height="256" fill="#fff" stroke="none" />
      <circle class="sm-b" cx="128" cy="128" r="38" fill="#000" stroke="none" />
    </mask>
    <clipPath id="sm-in"><circle cx="128" cy="128" r="64" /></clipPath>
    <path class="sm-rays" d="M128 16v24M128 216v24M16 128h24M216 128h24M48 48l16 16M208 48l-16 16M48 208l16-16M208 208l-16-16" />
    <g class="sm-orb">
      <circle cx="128" cy="128" r="56" mask="url(#sm-cut)" />
      <g clip-path="url(#sm-in)"><circle class="sm-b" cx="128" cy="128" r="46" /></g>
    </g>
  </svg>
</button>

<script>
  import { loop } from '../scripts/blob';

  // Follows the system until clicked, then flips dark and light and remembers it (localStorage 'theme').
  // Every change fires `theme:change` on window so the splash can redraw in the new ink. One script drives every
  // switch on the page.
  const root = document.documentElement;
  const btns = document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]');
  const light = matchMedia('(prefers-color-scheme: light)');
  const isDark = () => (root.dataset.theme ? root.dataset.theme === 'dark' : !light.matches);

  function sync() {
    // The icon (CSS) and the name both say what a click does.
    const label = isDark() ? 'Switch to light theme' : 'Switch to dark theme';
    btns.forEach((b) => b.setAttribute('aria-label', label));
  }
  const changed = () => window.dispatchEvent(new CustomEvent('theme:change'));

  const apply = () => {
    const next = isDark() ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {}
    sync();
    changed();
  };

  // The pour (DESIGN.md §4): the new theme spills out of the switch over the old one as a liquid blob. A view
  // transition snapshots both; the new one is clipped to the blob, whose keyframes are worked out once per click, so
  // no rAF runs. The radius eases out to the farthest corner while three waves run round the rim at different rates.
  const N = 48, F = 50, TAU = Math.PI * 2; // rim points, keyframes

  // No two pours are alike: every knob rolls inside a range that still pours like liquid. Per wave: lobes k (whole,
  // so the rim closes), depth a (a share of the radius, the long waves deepest, never more than 16% in all), speed v
  // in rad/s either way round, and phase p.
  const rnd = (lo: number, hi: number) => lo + Math.random() * (hi - lo);
  const wave = (k: [number, number], a: [number, number], v: [number, number]) => ({
    k: k[0] + Math.floor(Math.random() * (k[1] - k[0] + 1)),
    a: rnd(...a),
    v: (Math.random() < 0.5 ? -1 : 1) * rnd(...v),
    p: rnd(0, TAU),
  });
  const roll = () => ({
    T: rnd(850, 1250), // ms
    ease: rnd(1.7, 2.6), // ease-out power
    waves: [wave([3, 5], [0.04, 0.08], [3, 6]), wave([6, 9], [0.025, 0.05], [4, 7]), wave([10, 14], [0.01, 0.03], [2, 5])],
  });

  const pourFrames = (x: number, y: number, { T, ease, waves }: ReturnType<typeof roll>) => {
    const far = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));
    const R = far / (1 - waves.reduce((sum, w) => sum + w.a, 0)) + 8; // the rim's deepest dip still clears the far corner
    const frames: string[] = [];
    for (let i = 0; i <= F; i++) {
      const s = i / F, t = (s * T) / 1000, r = R * (1 - (1 - s) ** ease);
      const rim: [number, number][] = [];
      for (let j = 0; j < N; j++) {
        const th = (j / N) * TAU;
        const w = waves.reduce((sum, { k, a, v, p }) => sum + a * Math.sin(k * th + v * t + p), 1);
        rim.push([x + Math.cos(th) * r * w, y + Math.sin(th) * r * w]);
      }
      frames.push(`path('${loop(rim)}')`);
    }
    return frames;
  };

  const still = matchMedia('(prefers-reduced-motion: reduce)');
  let pouring: ViewTransition | undefined;
  const pour = (from: Element, apply: () => void) => {
    if (still.matches || !document.startViewTransition) return apply();
    const knobs = roll();
    const b = from.getBoundingClientRect();
    const x = b.left + b.width / 2, y = b.top + b.height / 2;
    root.classList.add('pour');
    const vt = (pouring = document.startViewTransition(apply));
    vt.ready
      .then(() => root.animate({ clipPath: pourFrames(x, y, knobs) }, { duration: knobs.T, pseudoElement: '::view-transition-new(root)' }))
      .catch(() => {});
    // A second click mid-pour skips this one; only the latest takes the class off.
    vt.finished.finally(() => pouring === vt && root.classList.remove('pour'));
  };
  btns.forEach((b) => b.addEventListener('click', () => pour(b, apply)));
  light.addEventListener('change', () => {
    if (root.dataset.theme) return; // a picked theme ignores the system
    sync();
    changed();
  });
  sync();
</script>
