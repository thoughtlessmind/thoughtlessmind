---
/**
 * Terminal log line: `2026-09-08  ▸ Title ........ 6 MIN`, then the one-line summary and tags.
 * Used by the home "// 02 LOGS" list, the /writing listings and Related. Shared contract: keep props stable.
 * The whole row is the title link's hit area; tag links sit above it.
 */
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
import { isoDate, readingTime } from '../lib/posts';

interface Props {
  post: CollectionEntry<'blog'>;
  /** Heading element for the title. Listing pages pass 'h2' (right under the page h1). */
  level?: 'h2' | 'h3';
  /** Show tag chips (default true). */
  showTag?: boolean;
  /** How many tag chips to show (default 3), so tag counts match what readers see. */
  maxTags?: number;
  /** Part number for series pages, e.g. "01". */
  number?: string;
  class?: string;
}
const { post, level = 'h3', showTag = true, maxTags = 3, number, class: className } = Astro.props;
const Title = level;
const { external, draft, title, description, pubDate } = post.data;
const href = external ?? `/writing/${post.id}/`;
const tags = showTag ? post.data.tags.slice(0, maxTags) : [];
// External cross-posts may carry only a stub body, so they get no reading time.
const minutes = external ? null : readingTime(post.body).minutes;
---

<li class:list={['post-row', { 'post-row--numbered': number }, className]}>
  {number && <span class="post-row__num" aria-label={`Part ${Number(number)}`}>{number}</span>}
  <time class="post-row__date" datetime={pubDate.toISOString()}>{isoDate(pubDate)}</time>
  <div class="post-row__main">
    <div class="post-row__line">
      <span class="post-row__marker" aria-hidden="true">▸</span>
      <Title class="post-row__title">
        <a
          href={href}
          class="post-row__link"
          transition:name={`post-${post.id}`}
          {...(external ? { rel: 'noopener', target: '_blank' } : {})}
        >
          {title}{external && <Icon name="arrow-up-right" size={14} class="post-row__ext" />}
        </a>
      </Title>
      {draft && <span class="draft-badge">Draft</span>}
      <span class="post-row__leader" aria-hidden="true"></span>
      {minutes && <span class="post-row__min">{minutes} min</span>}
    </div>
    <p class="post-row__summary">{description}</p>
    {
      tags.length > 0 && (
        <ul class="post-row__tags" aria-label="Tags">
          {tags.map((tag) => (
            <li>
              <a href={`/writing/tag/${tag}/`} class="tag">
                {tag}
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</li>

<style>
  .post-row {
    position: relative;
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr);
    align-items: baseline;
    column-gap: 1.5rem;
    padding-block: 1.125rem;
  }
  .post-row--numbered {
    grid-template-columns: max-content max-content minmax(0, 1fr);
  }
  .post-row__num,
  .post-row__date,
  .post-row__min,
  .post-row__leader {
    font-family: var(--font-ui);
    font-size: var(--text-caption);
    font-variant-numeric: tabular-nums;
    color: var(--text-subtle);
    white-space: nowrap;
  }
  .post-row__num {
    color: var(--accent);
  }

  /* Marker and title sit on the first line (so the date lines up with it); badge, leader and minutes on the last. */
  .post-row__line {
    display: flex;
    align-items: baseline;
    gap: 0.625rem;
  }
  .post-row__leader,
  .post-row__min {
    align-self: last baseline;
  }
  .post-row__marker {
    flex: none;
    font-family: var(--font-ui);
    font-size: var(--text-caption);
    color: var(--text-subtle);
    transition: color var(--dur-1) var(--ease-out);
  }
  .post-row__title {
    min-width: 0;
    font-family: var(--font-ui);
    font-size: var(--text-body);
    font-weight: 500;
    line-height: 1.45;
    text-wrap: pretty;
  }
  .post-row__link {
    color: var(--text);
    text-decoration: none;
    transition: color var(--dur-1) var(--ease-out);
  }
  /* Whole row is the link's hit area. */
  .post-row__link::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .post-row__link:focus-visible {
    outline: none;
  }
  .post-row__link:focus-visible::after {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }
  .post-row :global(.post-row__ext) {
    display: inline;
    margin-left: 0.25rem;
    vertical-align: -0.1em;
  }
  .post-row :global(.draft-badge) {
    flex: none;
    align-self: last baseline;
  }

  /* Dot leaders: a long run of dots clipped to whatever width is left on the line. */
  .post-row__leader {
    flex: 1 1 2rem;
    min-width: 2rem;
    overflow: hidden;
    opacity: 0.7;
  }
  .post-row__leader::before {
    content: '................................................................................................................................................................';
  }
  .post-row__min {
    flex: none;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .post-row__summary {
    margin-top: 0.25rem;
    max-width: var(--container-measure);
    font-size: var(--text-small);
    color: var(--text-muted);
  }
  .post-row__tags {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0.625rem 0 0;
    padding: 0;
    list-style: none;
  }

  .post-row:hover .post-row__marker,
  .post-row:focus-within .post-row__marker,
  .post-row:hover .post-row__link {
    color: var(--accent);
  }

  /* Phones: date above the title, the title takes the full width, badge + leader + minutes drop to the next line. */
  @media (max-width: 640px) {
    .post-row__line {
      flex-wrap: wrap;
      row-gap: 0.25rem;
    }
    .post-row__marker {
      display: none;
    }
    .post-row__title {
      flex-basis: 100%;
    }
    .post-row,
    .post-row--numbered {
      grid-template-columns: minmax(0, 1fr);
    }
    .post-row--numbered {
      grid-template-columns: max-content minmax(0, 1fr);
      column-gap: 0.75rem;
    }
    .post-row--numbered .post-row__main {
      grid-column: 1 / -1;
    }
  }
</style>
