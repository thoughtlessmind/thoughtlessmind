---
/**
 * Section header: the title, and an optional link on the same line. One hairline above groups the section.
 * No index, no eyebrow: the title names the section on its own.
 */
interface Props {
  title: string;
  href?: string;
  linkLabel?: string;
  level?: 'h2' | 'h3';
  id?: string;
  class?: string;
}
const { title, href, linkLabel = 'All', level: Tag = 'h2', id, class: className } = Astro.props;
---

<div class:list={['section-heading', className]}>
  <Tag id={id} class="section-heading__title">{title}</Tag>
  {
    href && (
      <a href={href} class="label link section-heading__link tap">
        <span data-scramble="hover">{linkLabel}</span>
        <span aria-hidden="true">→</span>
      </a>
    )
  }
</div>

<style>
  .section-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    margin-bottom: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }
  .section-heading__title {
    max-width: 24ch;
  }
  .section-heading__link {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    color: var(--text-muted);
    white-space: nowrap;
  }
  .section-heading__link:hover,
  .section-heading__link:focus-visible {
    color: var(--accent);
  }
</style>
