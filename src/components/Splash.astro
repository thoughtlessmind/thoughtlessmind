---
// The splash screen (src/scripts/splash): a full-screen canvas over the page while it plays. The gate in
// BaseLayout's head decides before paint whether it plays and hides the logo and the content until it lands.
---

<canvas data-splash-stage aria-hidden="true"></canvas>

<script>
  import '../scripts/splash';
</script>

<style is:global>
  [data-splash-stage] {
    display: none;
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 50;
    pointer-events: none;
  }
  html.splash [data-splash-stage] { display: block; }
  html.docked [data-splash-stage] { visibility: hidden; }
  /* The page holds at the top until the content rises; the gutter keeps the width from jumping when it scrolls again. */
  html.splash:not(.go) { overflow: hidden; scrollbar-gutter: stable; }

  html.splash:not(.docked) .mark { opacity: 0; }

  html.splash:not(.go) .rise { opacity: 0; }
  html.go .rise { animation: splash-rise 800ms var(--ease) both; animation-delay: calc(var(--d, 0) * 1ms); }
  /* A screen taller than the landing shows what follows it: that waits too, and rises with the last fact row. */
  html.splash:not(.go) :is(main > :not(:first-child), main ~ footer) { opacity: 0; }
  html.go :is(main > :not(:first-child), main ~ footer) { animation: splash-rise 800ms var(--ease) 500ms both; }
  @keyframes splash-rise { from { opacity: 0; transform: translateY(20px); } }
</style>
