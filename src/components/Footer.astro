---
import { SITE } from '../consts';
import name from '../assets/name.svg?raw';

const socials = [
  ['GitHub', SITE.socials.github],
  ['LinkedIn', SITE.socials.linkedin],
  ['X', SITE.socials.x],
  ['dev.to', SITE.socials.devto],
  ['Stack Overflow', SITE.socials.stackoverflow],
];
// `data-foot` is also the home page's scroll spy hook (the footer counts as Projects there).
---

<footer class="foot wrap" data-foot>
  <div class="foot-row">
    <p class="mail">Write to me at <a class="ul" href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
    <ul class="soc">
      {
        socials.map(([label, href]) => (
          <li>
            <a class="ul" href={href} rel="noopener me" target="_blank">
              {label}
            </a>
          </li>
        ))
      }
      <li><a class="ul" href="/llms.txt">llms.txt</a></li>
    </ul>
    <p>© {new Date().getFullYear()} {SITE.name}</p>
  </div>
  <div class="word" aria-hidden="true"><Fragment set:html={name} /></div>
</footer>

<script>
  import { loop } from '../scripts/blob';

  // The name draws itself once, the first time a quarter of the footer is on screen.
  const foot = document.querySelector<HTMLElement>('[data-foot]');
  if (foot)
    new IntersectionObserver(
      ([e], io) => {
        if (!e.isIntersecting) return;
        foot.classList.add('in');
        io.disconnect();
      },
      { threshold: 0.25 },
    ).observe(foot);

  // A liquid blob trails a mouse over the name and shows its orange fill (DESIGN.md §4). The blob is the clip path
  // of the fill; it springs after the cursor, stretches along its speed and wobbles at the rim. rAF runs only while
  // the cursor is on the name or the blob is melting away. Under reduced motion it is a plain circle on the cursor.
  const svg = foot?.querySelector<SVGSVGElement>('.word svg');
  const blob = svg?.querySelector('clipPath path');
  if (svg && blob && matchMedia('(hover: hover) and (pointer: fine)').matches) {
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const vb = svg.viewBox.baseVal;
    const R = 140, N = 36, TAU = Math.PI * 2;
    let on = false, raf = 0, last = 0, t = 0;
    let cx = 0, cy = 0, tx = 0, ty = 0, x = 0, y = 0, vx = 0, vy = 0, r = 0, vr = 0;

    const aim = () => {
      const b = svg.getBoundingClientRect(), k = vb.width / b.width;
      tx = vb.x + (cx - b.left) * k;
      ty = vb.y + (cy - b.top) * k;
    };
    const draw = () => {
      const a = 1 + Math.min(Math.hypot(vx, vy) / 2400, 0.5), b = 1 / Math.sqrt(a), dir = Math.atan2(vy, vx);
      const p: [number, number][] = [];
      for (let i = 0; i < N; i++) {
        const th = (i / N) * TAU, ph = th - dir;
        const w = still ? 1 : 1 + 0.05 * Math.sin(3 * th + 1.7 * t) + 0.035 * Math.sin(5 * th - 2.3 * t) + 0.025 * Math.sin(2 * th + 1.1 * t);
        const rr = (r * w) / Math.hypot(Math.cos(ph) / a, Math.sin(ph) / b);
        p.push([x + Math.cos(th) * rr, y + Math.sin(th) * rr]);
      }
      blob.setAttribute('d', loop(p));
    };
    const tick = (now: number) => {
      const dt = last ? Math.min((now - last) / 1000, 1 / 30) : 1 / 60;
      last = now;
      t += dt;
      aim();
      // Springs: the centre a little loose so it trails, the radius bouncy so the blob swells in like a drop.
      const ax = 160 * (tx - x) - 18 * vx, ay = 160 * (ty - y) - 18 * vy;
      vx += ax * dt; vy += ay * dt; x += vx * dt; y += vy * dt;
      vr += (190 * ((on ? R : 0) - r) - 14 * vr) * dt;
      r = Math.max(0, r + vr * dt);
      if (!on && r < 1) {
        blob.setAttribute('d', '');
        raf = last = 0;
        return;
      }
      draw();
      raf = requestAnimationFrame(tick);
    };

    const word = svg.parentElement!;
    const track = (e: PointerEvent) => {
      cx = e.clientX;
      cy = e.clientY;
      if (!still) return;
      aim();
      x = tx; y = ty; r = R;
      draw();
    };
    word.addEventListener('pointerenter', (e) => {
      if (e.pointerType === 'touch') return;
      on = true;
      track(e);
      if (still) return;
      if (r < 1) {
        aim();
        x = tx; y = ty; vx = vy = 0;
      }
      if (!raf) raf = requestAnimationFrame(tick);
    });
    word.addEventListener('pointermove', (e) => on && track(e));
    word.addEventListener('pointerleave', () => {
      on = false;
      if (still) blob.setAttribute('d', '');
    });
  }
</script>

<style>
  /* The address, socials and copyright, then "rajiv" across the content width, its top half showing. */
  .foot {
    overflow: hidden;
    padding-top: 168px;
  }
  .foot-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px 40px;
    font-size: var(--t-xs);
    color: var(--muted);
  }
  .mail {
    font-size: var(--t-s);
    color: var(--ink);
  }
  .soc {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
  }
  /* The name: hand-drawn outlines of Geist 500 (src/assets/name.svg), as wide as the content and cropped to the top
     of its letters by the viewBox. The pen is faint; the orange fill shows only inside the cursor's blob. */
  .word {
    margin-top: 72px;
    --pen: 3.5;
  }
  .word :global(svg) {
    display: block;
    width: 100%;
    height: auto;
    overflow: hidden;
  }
  .word :global(.pen) {
    fill: none;
    stroke: color-mix(in oklab, var(--muted) 70%, transparent);
    stroke-width: var(--pen);
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .word :global(.ink) {
    fill: var(--logo);
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .word :global(.pen path) {
      animation: name-draw calc(var(--t) * 1ms) var(--ease) calc(var(--d) * 1ms) backwards paused;
    }
    :global(html.js) .foot.in .word :global(.pen path) {
      animation-play-state: running;
    }
  }
  @keyframes name-draw {
    from { stroke-dasharray: 1; stroke-dashoffset: 1; visibility: hidden; }
    to { stroke-dasharray: 1; stroke-dashoffset: 0; }
  }
  @media (max-width: 720px) {
    .foot {
      padding-top: 112px;
    }
    .foot-row {
      flex-direction: column;
      align-items: flex-start;
    }
    .word {
      margin-top: 48px;
      --pen: 7;
    }
  }
</style>
