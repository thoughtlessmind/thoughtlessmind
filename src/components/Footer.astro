---
import { SITE } from '../consts';
import name from '../assets/name.svg?raw';

const socials = [
  ['GitHub', SITE.socials.github],
  ['LinkedIn', SITE.socials.linkedin],
  ['X', SITE.socials.x],
  ['dev.to', SITE.socials.devto],
  ['Stack Overflow', SITE.socials.stackoverflow],
];
// `data-foot` is also the home page's scroll spy hook (the footer counts as Projects there).
---

<footer class="foot wrap" data-foot>
  <div class="foot-row">
    <p class="mail">Write to me at <a class="ul" href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
    <ul class="soc">
      {
        socials.map(([label, href]) => (
          <li>
            <a class="ul" href={href} rel="noopener me" target="_blank">
              {label}
            </a>
          </li>
        ))
      }
      <li><a class="ul" href="/llms.txt">llms.txt</a></li>
    </ul>
    <p>© {new Date().getFullYear()} {SITE.name}</p>
  </div>
  <div class="word" aria-hidden="true"><Fragment set:html={name} /></div>
</footer>

<script>
  import { trail } from '../scripts/blob';

  // The name draws itself once, the first time a quarter of the footer is on screen.
  const foot = document.querySelector<HTMLElement>('[data-foot]');
  if (foot)
    new IntersectionObserver(
      ([e], io) => {
        if (!e.isIntersecting) return;
        foot.classList.add('in');
        io.disconnect();
      },
      { threshold: 0.25 },
    ).observe(foot);

  // A liquid blob trails a mouse over the name and shows its orange fill (DESIGN.md §4): the blob is the clip path
  // of the fill.
  const svg = foot?.querySelector<SVGSVGElement>('.word svg');
  const blob = svg?.querySelector('clipPath path');
  if (svg && blob) trail(svg.parentElement!, svg, [blob], 140);
</script>

<style>
  /* The address, socials and copyright, then "rajiv" across the content width, its top half showing. */
  .foot {
    overflow: hidden;
    padding-top: 168px;
  }
  .foot-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px 40px;
    font-size: var(--t-xs);
    color: var(--muted);
  }
  .mail {
    font-size: var(--t-s);
    color: var(--ink);
  }
  .soc {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
  }
  /* The name: hand-drawn outlines of Geist 500 (src/assets/name.svg), as wide as the content and cropped to the top
     of its letters by the viewBox. The pen is faint; the orange fill shows only inside the cursor's blob. */
  .word {
    margin-top: 72px;
    --pen: 3.5;
  }
  .word :global(svg) {
    display: block;
    width: 100%;
    height: auto;
    overflow: hidden;
  }
  .word :global(.pen) {
    fill: none;
    stroke: color-mix(in oklab, var(--muted) 70%, transparent);
    stroke-width: var(--pen);
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .word :global(.ink) {
    fill: var(--logo);
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .word :global(.pen path) {
      animation: name-draw calc(var(--t) * 1ms) var(--ease) calc(var(--d) * 1ms) backwards paused;
    }
    :global(html.js) .foot.in .word :global(.pen path) {
      animation-play-state: running;
    }
  }
  @keyframes name-draw {
    from { stroke-dasharray: 1; stroke-dashoffset: 1; visibility: hidden; }
    to { stroke-dasharray: 1; stroke-dashoffset: 0; }
  }
  @media (max-width: 720px) {
    .foot {
      padding-top: 112px;
    }
    .foot-row {
      flex-direction: column;
      align-items: flex-start;
    }
    .word {
      margin-top: 48px;
      --pen: 7;
    }
  }
</style>
