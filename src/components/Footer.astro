---
import { SITE } from '../consts';
import Terminal from './Terminal.astro';

// The one list of profile links on the site (rel="me" for identity verification).
const socials = [
  { label: 'GitHub', href: SITE.socials.github },
  { label: 'LinkedIn', href: SITE.socials.linkedin },
  { label: 'X', href: SITE.socials.x },
  { label: 'Stack Overflow', href: SITE.socials.stackoverflow },
  { label: 'dev.to', href: SITE.socials.devto },
  { label: 'RSS', href: '/rss.xml' },
];
---

<footer class="site-footer">
  <div class="container-site">
    <div class="hud footer-frame">
      <p class="footer-id">Built by {SITE.name} in New Delhi.</p>

      <ul class="footer-socials" aria-label="Elsewhere">
        {
          socials.map((s) => (
            <li>
              <a href={s.href} class="footer-social tap" rel={s.href.startsWith('http') ? 'me noopener' : undefined}>
                {s.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</footer>
<Terminal />

<style>
  .site-footer {
    margin-top: calc(var(--spacing-section) / 2);
    padding-bottom: 2rem;
  }
  .footer-frame {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 1.25rem 3rem;
    padding: 1.5rem clamp(1.25rem, 3vw, 2rem);
    background: color-mix(in srgb, var(--bg) 85%, transparent);
  }
  .footer-id {
    font-size: var(--text-small);
    color: var(--text-muted);
  }
  .footer-socials {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .footer-social {
    font-family: var(--font-ui);
    font-size: var(--text-caption);
    font-weight: 500;
    color: var(--text-muted);
    text-decoration: underline 1px transparent;
    text-underline-offset: 0.35em;
    transition:
      color var(--dur-1) var(--ease-out),
      text-decoration-color var(--dur-1) var(--ease-out);
  }
  .footer-social:hover,
  .footer-social:focus-visible {
    color: var(--text);
    text-decoration-color: var(--signal);
  }
  @media (max-width: 767px) {
    .footer-frame {
      grid-template-columns: 1fr;
    }
  }
</style>
