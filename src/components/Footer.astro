---
import { SITE } from '../consts';

const socials = [
  ['GitHub', SITE.socials.github],
  ['LinkedIn', SITE.socials.linkedin],
  ['X', SITE.socials.x],
  ['Stack Overflow', SITE.socials.stackoverflow],
];
// `data-foot` is also the home page's scroll spy hook (the footer counts as Projects there).
---

<footer class="foot wrap" data-foot>
  <div class="foot-row">
    <p class="mail">Write to me at <a class="ul" href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
    <ul class="soc">
      {
        socials.map(([label, href]) => (
          <li>
            <a class="ul hit" href={href} rel="noopener me" target="_blank">
              {label}<span class="sr-only"> (opens in a new tab)</span>
            </a>
          </li>
        ))
      }
      <li><a class="ul hit" href="/rss.xml">RSS</a></li>
      <li><a class="ul hit" href="/llms.txt">llms.txt</a></li>
    </ul>
    <p>© {new Date().getFullYear()} {SITE.name} · New Delhi, India</p>
  </div>
  <canvas class="field" aria-hidden="true"></canvas>
</footer>

<script>
  import { field } from '../scripts/field';

  // The star field under the links (DESIGN.md §4): a dot grid a mouse stirs like a gravity well.
  const c = document.querySelector<HTMLCanvasElement>('.foot .field');
  if (c) field(c);
</script>

<style>
  /* The address, socials and copyright, then the star field across the content width. */
  .foot {
    overflow: hidden;
    padding-top: 168px;
  }
  .foot-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px 40px;
    font-size: var(--t-xs);
    color: var(--muted);
  }
  .mail {
    font-size: var(--t-s);
    color: var(--ink);
  }
  .soc {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
  }
  /* Each link takes a finger (`.hit` in global.css), the one-letter X included. */
  /* The star field: a canvas (scripts/field.ts) that reads its dot colour from `color`. It runs the full width of the
     window, out through the page margins (the footer clips it at the edges). */
  .field {
    display: block;
    width: calc(100% + var(--gut) + var(--gut-r));
    margin-inline: calc(-1 * var(--gut)) calc(-1 * var(--gut-r));
    height: clamp(200px, 21vw, 300px);
    margin-top: 64px;
    color: var(--muted);
  }
  @media (max-width: 720px) {
    .foot {
      padding-top: 112px;
    }
    .foot-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 20px;
    }
    .soc {
      row-gap: 24px;
    }
    .field {
      margin-top: 40px;
    }
  }
</style>
