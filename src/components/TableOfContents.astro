---
/**
 * `> section` list from render() headings (depth 2-3). The rail variant carries its own label;
 * the inline variant sits inside a <details> on narrow screens. One script tracks the active heading.
 */
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
  variant?: 'rail' | 'inline';
  class?: string;
}
const { headings, variant = 'rail', class: className } = Astro.props;
const items = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{
  items.length > 0 && (
    <nav class:list={['toc', className]} aria-label="On this page" data-toc>
      {variant === 'rail' && <p class="label toc__label">On this page</p>}
      <ol class="toc__list">
        {items.map((h) => (
          <li class:list={['toc__item', { 'toc__item--sub': h.depth === 3 }]}>
            <a href={`#${h.slug}`} class="toc__link" data-toc-link={h.slug}>
              {h.text}
            </a>
          </li>
        ))}
      </ol>
    </nav>
  )
}

<style>
  .toc__label {
    margin-bottom: 1rem;
    color: var(--text-subtle);
  }
  .toc__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .toc__link {
    display: grid;
    grid-template-columns: 1.25rem minmax(0, 1fr);
    padding-block: 0.375rem;
    font-family: var(--font-ui);
    font-size: var(--text-caption);
    line-height: 1.5;
    color: var(--text-muted);
    text-decoration: none;
    text-wrap: pretty;
    transition: color var(--dur-1) var(--ease-out);
  }
  .toc__link::before {
    content: '>' / '';
    color: var(--text-subtle);
  }
  .toc__item--sub .toc__link {
    padding-left: 1.25rem;
  }
  .toc__item--sub .toc__link::before {
    content: '-' / '';
  }
  .toc__link:hover {
    color: var(--text);
  }
  .toc__link.is-active,
  .toc__link.is-active::before {
    color: var(--accent);
  }
</style>

<script>
  // Active = last heading whose top has passed the 20% line (the end stack below the article lets the last one get there).
  // Recomputed whenever a heading crosses that line.
  let stop: (() => void) | undefined;

  function init() {
    stop?.();
    stop = undefined;
    const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]')];
    const ids = [...new Set(links.map((l) => l.dataset.tocLink!))];
    const heads = ids.map((id) => document.getElementById(id)).filter((el): el is HTMLElement => !!el);
    if (!heads.length) return;

    const mark = () => {
      const line = window.innerHeight * 0.2;
      let current = heads[0].id;
      for (const h of heads) if (h.getBoundingClientRect().top <= line) current = h.id;
      for (const l of links) {
        const on = l.dataset.tocLink === current;
        l.classList.toggle('is-active', on);
        if (on) l.setAttribute('aria-current', 'true');
        else l.removeAttribute('aria-current');
      }
    };
    // The observed box is everything above the 20% line, so a heading fires once each time it crosses that line, in
    // either direction, however fast the page moves; no scroll listener.
    const io = new IntersectionObserver(mark, { rootMargin: '100000px 0px -80% 0px' });
    for (const h of heads) io.observe(h);
    stop = () => io.disconnect();
    mark();
  }

  document.addEventListener('astro:page-load', init);
  document.addEventListener('astro:before-swap', () => stop?.());
</script>
