---
/** Share intents as plain anchors (X, LinkedIn, Bluesky) plus a copy-link button, as mono ghost buttons. No SDKs. */
interface Props {
  url: string;
  title: string;
}
const { url, title } = Astro.props;
const enc = encodeURIComponent;
const links = [
  { label: 'X', href: `https://x.com/intent/post?text=${enc(title)}&url=${enc(url)}` },
  { label: 'LinkedIn', href: `https://www.linkedin.com/sharing/share-offsite/?url=${enc(url)}` },
  { label: 'Bluesky', href: `https://bsky.app/intent/compose?text=${enc(`${title} ${url}`)}` },
];
---

<div class="share">
  <p class="label share__label">Share</p>
  <ul class="share__row">
    {
      links.map((l) => (
        <li>
          <a href={l.href} class="btn btn-ghost btn-sm" rel="noopener" target="_blank">
            {l.label}
          </a>
        </li>
      ))
    }
    <li>
      <button type="button" class="btn btn-ghost btn-sm" data-copy-link={url}>
        <span data-copy-label>Copy link</span>
      </button>
    </li>
  </ul>
  <p class="sr-only" aria-live="polite" data-copy-status></p>
</div>

<style>
  .share {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
  }
  .share__label {
    color: var(--text-subtle);
  }
  .share__row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  [data-copied] {
    color: var(--accent);
  }
</style>

<script>
  document.addEventListener('click', async (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-copy-link]');
    if (!btn) return;
    try {
      await navigator.clipboard.writeText(btn.dataset.copyLink!);
    } catch {
      return;
    }
    const label = btn.querySelector('[data-copy-label]');
    const status = btn.closest('.share')?.querySelector('[data-copy-status]');
    btn.dataset.copied = 'true';
    if (label) label.textContent = 'Copied';
    if (status) status.textContent = 'Link copied to clipboard';
    window.setTimeout(() => {
      delete btn.dataset.copied;
      if (label) label.textContent = 'Copy link';
      if (status) status.textContent = '';
    }, 1500);
  });
</script>
