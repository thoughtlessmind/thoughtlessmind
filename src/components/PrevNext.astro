---
/** HUD cells: older on the left, newer on the right. A lone neighbour takes the full width; no empty cell. */
import type { Post } from '../lib/posts';

interface Props {
  older?: Post;
  newer?: Post;
}
const { older, newer } = Astro.props;
const cells = [
  { label: '← Older', post: older, newer: false },
  { label: 'Newer →', post: newer, newer: true },
].filter((c): c is { label: string; post: Post; newer: boolean } => !!c.post);
---

{
  cells.length > 0 && (
    <nav class="prevnext" aria-label="Older and newer posts">
      {cells.map(({ label, post, newer }) => (
        <a href={`/writing/${post.id}/`} class:list={['hud prevnext__cell', { 'prevnext__cell--newer': newer }]}>
          <span class="label prevnext__label">{label}</span>
          <span class="prevnext__title">{post.data.title}</span>
        </a>
      ))}
    </nav>
  )
}

<style>
  .prevnext {
    display: grid;
    grid-auto-columns: minmax(0, 1fr);
    grid-auto-flow: column;
    gap: 1rem;
  }
  .prevnext__cell {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.25rem;
    color: var(--text);
    text-decoration: none;
    transition: background-color var(--dur-1) var(--ease-out);
  }
  .prevnext__cell:hover {
    background: var(--surface);
  }
  .prevnext__cell--newer:not(:only-child) {
    text-align: right;
  }
  .prevnext__label {
    color: var(--text-subtle);
  }
  .prevnext__cell:hover .prevnext__label {
    color: var(--accent);
  }
  .prevnext__title {
    font-family: var(--font-ui);
    font-size: var(--text-small);
    font-weight: 500;
    line-height: 1.45;
    text-wrap: pretty;
  }
  @media (max-width: 560px) {
    .prevnext {
      grid-auto-flow: row;
    }
    .prevnext__cell--newer:not(:only-child) {
      text-align: left;
    }
  }
</style>
