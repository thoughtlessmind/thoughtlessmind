---
/** Up to three posts as log lines (PostRow, no tags). Labelled "Related" (tag overlap) or "Latest" (none overlaps). */
import PostRow from './PostRow.astro';
import type { Post } from '../lib/posts';

interface Props {
  posts: Post[];
  label?: string;
}
const { posts, label = 'Related' } = Astro.props;
---

{
  posts.length > 0 && (
    <section aria-labelledby="related-label">
      <p class="label related__label" id="related-label">
        {label}
      </p>
      <ul class="rows">
        {posts.map((p) => (
          <PostRow post={p} showTag={false} />
        ))}
      </ul>
    </section>
  )
}

<style>
  .related__label {
    margin-bottom: 0.875rem;
    color: var(--text-subtle);
  }
</style>
