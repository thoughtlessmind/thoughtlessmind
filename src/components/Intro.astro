---
// The page-load intro (src/scripts/intro): a full-screen canvas over the page while it plays. The gate in
// BaseLayout's head decides before paint whether it plays and hides the logo and the content until it lands.
---

<canvas data-intro-stage aria-hidden="true"></canvas>

<script>
  import '../scripts/intro';
</script>

<style is:global>
  [data-intro-stage] {
    display: none;
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 50;
    pointer-events: none;
  }
  html.intro [data-intro-stage] { display: block; }
  html.docked:not(.skip) [data-intro-stage] { visibility: hidden; }
  html.skip [data-intro-stage] { opacity: 0; transition: opacity 300ms var(--ease); }

  html.intro:not(.docked) .mark { opacity: 0; }
  html.skip .mark { transition: opacity 300ms var(--ease); }

  html.intro:not(.go) .rise { opacity: 0; }
  html.go .rise { animation: intro-rise 800ms var(--ease) both; animation-delay: calc(var(--d, 0) * 1ms); }
  @keyframes intro-rise { from { opacity: 0; transform: translateY(20px); } }
</style>
