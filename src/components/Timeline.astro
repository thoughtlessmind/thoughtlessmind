---
/**
 * Experience as one timeline: a vertical hairline, square nodes, the current node filled in accent.
 * Roles get a title line; milestones are a single line. The current employer is named only here (about page).
 */
import { SITE } from '../consts';

const entries: { year: string; title: string; text?: string; now?: boolean }[] = [
  { year: String(SITE.since), title: 'Started building for the web. First answers on Stack Overflow.' },
  {
    year: '2020',
    title: `Frontend Engineer, ${SITE.previousCompany}`,
    text: 'A conversion-rate optimisation product for websites. I built and maintained its React frontend.',
  },
  { year: '2021', title: 'Published css-only-tooltip on npm. 900+ GitHub contributions that year.' },
  { year: '2023', title: 'Built Diver, a Chrome extension for inspecting page layout.' },
  {
    year: 'Now',
    title: `${SITE.role}, swipejobs`,
    text: 'An HR-tech platform that matches workers with jobs. I work on its web frontends in React and TypeScript.',
    now: true,
  },
];
---

<ol class="timeline">
  {
    entries.map((e) => (
      <li class:list={['timeline__item', { 'is-now': e.now }]}>
        <span class="timeline__year">{e.year}</span>
        <div>
          <p class:list={['timeline__title', { 'timeline__title--role': e.text }]}>{e.title}</p>
          {e.text && <p class="timeline__text">{e.text}</p>}
        </div>
      </li>
    ))
  }
</ol>

<style>
  .timeline {
    position: relative;
    margin: 0;
    padding: 0 0 0 1.75rem;
    list-style: none;
  }
  .timeline::before {
    content: '';
    position: absolute;
    top: 0.5rem;
    bottom: 0.5rem;
    left: 3.5px;
    width: 1px;
    background: var(--border-strong);
  }
  .timeline__item {
    position: relative;
    display: grid;
    grid-template-columns: 5ch minmax(0, 1fr);
    gap: 1rem;
    align-items: baseline;
  }
  .timeline__item + .timeline__item {
    margin-top: 1.5rem;
  }
  .timeline__item::before {
    content: '';
    position: absolute;
    top: 0.5rem;
    left: -1.75rem;
    width: 8px;
    height: 8px;
    border: 1px solid var(--border-strong);
    background: var(--bg);
  }
  .timeline__item.is-now::before {
    background: var(--accent);
    border-color: var(--accent);
  }
  .timeline__year {
    font-family: var(--font-ui);
    font-size: var(--text-caption);
    font-variant-numeric: tabular-nums;
    color: var(--text-subtle);
  }
  .is-now .timeline__year {
    color: var(--accent);
  }
  .timeline__title {
    color: var(--text);
  }
  .timeline__title--role {
    font-weight: 600;
  }
  .timeline__text {
    margin-top: 0.25rem;
    font-size: var(--text-small);
    color: var(--text-muted);
  }
</style>
