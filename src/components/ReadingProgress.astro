---
/**
 * 2px accent bar pinned under the sticky header, plus a `37%` readout hanging off its right end.
 * Progress runs through the article body (.prose), not the whole document, so it reads 100% at the last line.
 * No JS: a CSS view timeline on .prose drives both. Browsers without scroll-driven animations don't show it.
 */
---

<div class="reading-progress" aria-hidden="true">
  <div class="reading-progress__bar"></div>
  <span class="label reading-progress__readout"></span>
</div>

<style>
  .reading-progress {
    display: none;
  }

  @supports (timeline-scope: none) and (animation-timeline: view()) {
    /* The bar sits outside .prose, so the timeline is hoisted to the root. */
    :global(html) {
      timeline-scope: --article;
    }
    :global(article.prose) {
      view-timeline: --article block;
    }

    .reading-progress {
      display: block;
      position: fixed;
      top: var(--header-h);
      left: 0;
      right: 0;
      height: 2px;
      z-index: 39;
      pointer-events: none;
    }
    .reading-progress__bar {
      height: 100%;
      background: var(--accent);
      transform-origin: 0 50%;
      animation: reading-bar linear both;
    }
    /* Kept in its own, more specific rule: the build's minifier folds a same-rule animation-timeline into the
       `animation` shorthand, which browsers reject. From the body's top at the top of the viewport to its last line
       at the bottom. */
    .reading-progress > * {
      animation-timeline: --article;
      animation-range: contain 0% contain 100%;
    }
    .reading-progress__readout {
      position: absolute;
      top: 2px;
      right: var(--spacing-gutter);
      padding: 0.125rem 0.5rem;
      background: var(--bg);
      border: 1px solid var(--border);
      border-top: 0;
      color: var(--accent);
      font-variant-numeric: tabular-nums;
      counter-reset: pct var(--pct);
      animation: reading-pct linear both;
    }
    .reading-progress__readout::after {
      content: counter(pct) '%';
    }
  }

  @property --pct {
    syntax: '<integer>';
    inherits: false;
    initial-value: 0;
  }
  @keyframes reading-bar {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }
  @keyframes reading-pct {
    from {
      --pct: 0;
    }
    to {
      --pct: 100;
    }
  }

  @media print {
    .reading-progress {
      display: none;
    }
  }
</style>
