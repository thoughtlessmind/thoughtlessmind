---
/**
 * 2px accent bar pinned under the sticky header, plus a `037%` readout hanging off its right end.
 * Progress runs through the article body (.prose), not the whole document, so it reads 100% at the last line.
 */
---

<div class="reading-progress" aria-hidden="true" data-progress>
  <div class="reading-progress__bar"></div>
  <span class="label reading-progress__readout" data-progress-readout>000%</span>
</div>

<style>
  .reading-progress {
    position: fixed;
    top: var(--header-h);
    left: 0;
    right: 0;
    height: 2px;
    z-index: 39;
    pointer-events: none;
  }
  .reading-progress__bar {
    height: 100%;
    background: var(--accent);
    transform-origin: 0 50%;
    transform: scaleX(var(--progress, 0));
  }
  .reading-progress__readout {
    position: absolute;
    top: 2px;
    right: var(--spacing-gutter);
    padding: 0.125rem 0.5rem;
    background: var(--bg);
    border: 1px solid var(--border);
    border-top: 0;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }
  @media print {
    .reading-progress {
      display: none;
    }
  }
</style>

<script>
  // One rAF-throttled scroll listener for the whole session; it no-ops on pages without the bar.
  let queued = false;
  function update() {
    queued = false;
    const root = document.querySelector<HTMLElement>('[data-progress]');
    const body = document.querySelector<HTMLElement>('.prose');
    if (!root || !body) return;
    const r = body.getBoundingClientRect();
    const span = r.height - window.innerHeight;
    const p = span > 0 ? Math.min(1, Math.max(0, -r.top / span)) : r.top <= 0 ? 1 : 0;
    root.style.setProperty('--progress', String(p));
    root.querySelector('[data-progress-readout]')!.textContent = `${String(Math.round(p * 100)).padStart(3, '0')}%`;
  }
  const schedule = () => {
    if (!queued) (queued = true), requestAnimationFrame(update);
  };
  window.addEventListener('scroll', schedule, { passive: true });
  window.addEventListener('resize', schedule);
  document.addEventListener('astro:page-load', update);
</script>
