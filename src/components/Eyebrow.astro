---
/** Label (`.eyebrow` = `.label`): Martian Mono, uppercase via CSS. Optional muted index before it ("01"). */
interface Props {
  class?: string;
  as?: 'span' | 'p' | 'div';
  index?: string;
}
const { class: className, as: Tag = 'span', index }: Props = Astro.props;
---

<Tag class:list={['eyebrow', className]}>
  {index && <span class="eyebrow-index">{index}</span>}
  <slot />
</Tag>

<style>
  .eyebrow-index {
    margin-right: 0.75em;
    color: var(--text-subtle);
  }
</style>
