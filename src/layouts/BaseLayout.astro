---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Splash from '../components/Splash.astro';
import Overscroll from '../components/Overscroll.astro';
import { SITE } from '../consts';

export interface Props {
  title?: string;
  description?: string;
  /** Play the splash screen on a fresh load or reload (the home page). */
  splash?: boolean;
  /** The section the page belongs to, for the header nav's current link. */
  current?: 'blogs';
  /** The header's reading-progress line (post pages). */
  progress?: boolean;
  /** Open Graph type: a post is an article. */
  type?: 'website' | 'article';
  /** Structured data for the page (schema.org), as one object. */
  jsonLd?: Record<string, unknown>;
}

const { title = SITE.title, description = SITE.description, splash = false, current, progress = false, type = 'website', jsonLd } = Astro.props;
// No trailing slash (trailingSlash: 'never'); the root stays `/`.
const path = Astro.url.pathname;
const canonical = new URL(path.length > 1 ? path.replace(/\/+$/, '') : path, Astro.site);
// One link-preview card for every page: the landing drawing with the name and the headline (public/og.png).
const card = new URL('/og.png', Astro.site).href;
// ponytail: theme-color follows the system only; a theme picked with the switch keeps the system's bar colour.
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE.brand} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={card} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${SITE.name}. Software you don’t have to think about. A line drawing of a telescope, a ringed planet and a rocket.`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={card} />
    <link rel="alternate" type="application/rss+xml" href="/rss.xml" title={`${SITE.name}, blogs`} />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt" />
    {jsonLd && <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />}
    <slot name="head" />
    <meta name="theme-color" content="#03060c" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f3f2ee" media="(prefers-color-scheme: light)" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <script is:inline>
      // Before paint: `js` on <html> and the theme picked with the switch (it follows the system until then).
      (() => {
        const root = document.documentElement;
        root.classList.add('js');
        try {
          const t = localStorage.getItem('theme');
          if (t === 'dark' || t === 'light') root.dataset.theme = t;
          localStorage.removeItem('palette'); // the palette trial is over
        } catch {}
      })();
    </script>
    {
      splash && (
        <script is:inline>
          // Splash gate: decided before paint, so the page starts hidden instead of flashing. It plays once per tab
          // session, on a fresh arrival only: not on a reload, not after a click from this site (the header logo
          // included), not on back or forward. Never under reduced motion; ?splash=off skips it, ?splash=on forces it.
          // If the splash has not started within 2.5 s (its script failed or is slow), show the page anyway.
          (() => {
            const root = document.documentElement;
            const q = new URLSearchParams(location.search).get('splash');
            if (q === 'off') return;
            if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
            if (q !== 'on') {
              const type = performance.getEntriesByType('navigation')[0]?.type;
              let internal = false;
              try { internal = new URL(document.referrer).origin === location.origin; } catch {}
              if (type !== 'navigate' || internal) return;
              try {
                if (sessionStorage.getItem('splash')) return;
                sessionStorage.setItem('splash', '1');
              } catch {}
            }
            root.classList.add('splash');
            setTimeout(() => { if (!('splashRun' in root.dataset)) root.classList.remove('splash'); }, 2500);
          })();
        </script>
      )
    }
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header current={current} progress={progress} />
    <main class="wrap" id="main" tabindex="-1"><slot /></main>
    <Footer />
    <Overscroll />
    {splash && <Splash />}
  </body>
</html>
