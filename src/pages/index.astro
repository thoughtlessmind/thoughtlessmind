---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import SiteCaseStudy from '../components/SiteCaseStudy.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PostRow from '../components/PostRow.astro';
import Counters from '../components/Counters.astro';
import { SITE } from '../consts';
import { getSyndicatedPosts } from '../lib/posts';
import { person, PERSON_ID, WEBSITE_ID } from '../lib/person';

const projects = (await getCollection('projects', ({ data }) => data.featured && !data.archived)).sort(
  (a, b) => a.data.order - b.data.order,
);
const posts = (await getSyndicatedPosts()).slice(0, 3);
const counters = [
  { value: '98', label: 'Stack Overflow answers' },
  { value: '60', label: 'Accepted answers' },
  { value: '110', suffix: 'k+', label: 'Reads on one answer' },
  { value: '49', label: "Pull requests to other people's repos" },
];
const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': WEBSITE_ID,
  name: SITE.name,
  alternateName: SITE.handle,
  url: SITE.url,
  publisher: { '@id': PERSON_ID },
};
---

<BaseLayout title={SITE.title} description={SITE.description} jsonLd={[person(), website]}>
  <Hero />

  <section id="work" class="container-site section" aria-labelledby="work-title" data-reveal-group>
    <SectionHeading title="Selected work" id="work-title" class="reveal" />
    <div class="reveal"><SiteCaseStudy /></div>
    <ul class="home-modules">
      {projects.map((p) => <ProjectCard project={p} class="reveal" />)}
    </ul>
  </section>

  <section id="writing" class="container-site section" aria-labelledby="writing-title" data-reveal-group>
    <SectionHeading title="Latest writing" id="writing-title" href="/writing" linkLabel="All writing" class="reveal" />
    <ul class="rows">
      {posts.map((post) => <PostRow post={post} class="reveal" />)}
    </ul>
  </section>

  <section id="operator" class="container-site section" aria-labelledby="operator-title" data-reveal-group>
    <SectionHeading title="Track record" id="operator-title" href="/about" linkLabel="More about me" class="reveal" />
    <div class="record">
      <div class="record__bio reveal">
        <p>
          I'm {SITE.name}, a web engineer in New Delhi. I work on production React and TypeScript, answer frontend
          questions on Stack Overflow, and build small tools when an everyday annoyance needs a clean fix.
        </p>
        <p>Off the clock I read about rockets, orbital mechanics and physics, and watch whatever sport is on.</p>
      </div>
      <Counters items={counters} class="reveal" />
    </div>
  </section>

  <section id="contact" class="container-site section contact" aria-labelledby="transmit-title" data-reveal-group>
    <h2 id="transmit-title" class="page-title reveal">Get in touch</h2>
    <p class="contact__lead reveal">For a question about a post, a project or a role, email is the way to reach me.</p>
    <div class="contact__actions reveal">
      <a href={`mailto:${SITE.email}`} class="btn btn-primary"><span data-scramble="hover">Email me</span></a>
      <p class="contact__address">{SITE.email}</p>
    </div>
  </section>
</BaseLayout>

<style>
  .home-modules {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 720px) {
    .home-modules {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* Bio and numbers side by side from 900px; stacked (bio first) below. */
  .record {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2.5rem;
  }
  .record__bio {
    max-width: 60ch;
    font-size: var(--text-lead);
    line-height: var(--text-lead--line-height);
  }
  .record__bio p + p {
    margin-top: 1em;
    color: var(--text-muted);
  }
  @media (min-width: 900px) {
    .record {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: clamp(2.5rem, 5vw, 5rem);
      align-items: start;
    }
  }

  .contact {
    padding-bottom: var(--spacing-section);
  }
  .contact__lead {
    max-width: 44ch;
    margin-top: 1.25rem;
    font-size: var(--text-lead);
    line-height: var(--text-lead--line-height);
    color: var(--text-muted);
  }
  .contact__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
    margin-top: 2rem;
  }
  /* The address as plain text to copy; one click selects all of it. */
  .contact__address {
    font-family: var(--font-ui);
    font-size: var(--text-small);
    color: var(--text-muted);
    user-select: all;
    overflow-wrap: anywhere;
  }
</style>
