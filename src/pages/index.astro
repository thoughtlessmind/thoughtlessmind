---
import BaseLayout from '../layouts/BaseLayout.astro';
import Doodle from '../components/Doodle.astro';
import PostCard from '../components/PostCard.astro';
import { SITE } from '../consts';
import { cover, getPosts } from '../lib/writing';

// Each project links to the real thing; `go` says where. The stills are drawn in HTML below (DESIGN.md §5).
// The tools newest first, then this site as the colophon.
const work = [
  {
    id: 'diver',
    name: 'Diver',
    kind: 'Chrome extension',
    year: 2023,
    summary: 'Outlines every element on a page in one click, so you can see the boxes, nesting and spacing of a layout you didn’t write.',
    go: 'Get it for Chrome',
    href: 'https://chrome.google.com/webstore/detail/diver/onfnfdmnccoaknhjinebmlncejnofhoc',
  },
  {
    id: 'tooltip',
    name: 'css-only-tooltip',
    kind: 'Library',
    year: 2021,
    summary: 'A tooltip library with no JavaScript. Data attributes in, tooltip out, with light and dark themes and nothing to bundle.',
    go: 'View on npm',
    href: 'https://www.npmjs.com/package/css-only-tooltip',
  },
  {
    id: 'yt',
    name: 'YouTube Playlist Info',
    kind: 'Web app',
    year: 2020,
    summary: 'Paste a playlist link and see how long it really takes to watch, video by video, before you commit to it.',
    go: 'Open the app',
    href: 'https://youtube-playlist-info.netlify.app',
  },
  {
    id: 'site',
    name: 'rajiv.me',
    kind: 'This site',
    year: 2026,
    summary: 'Static pages, a drawing that draws itself and nothing running in the background once it has loaded. Every post is also served as Markdown, so AI tools can read it too.',
    go: 'Read the source',
    href: `${SITE.socials.github}/thoughtlessmind`,
  },
];
// The four newest posts that have a cover drawing; /writing has the rest. The four newest of all were four Material
// UI answers, two of them without a drawing. A new post shows here once its cover is drawn.
const all = await getPosts();
const posts = all.filter((p) => cover(p.id)).slice(0, 4);
// Now: one line on the problem, then the four parts of the answer, each in words a non-engineer can follow. The
// posts on these topics, once written, carry the technical detail (DESIGN.md §5).
const now = [
  ['Tools, not paragraphs', 'I connect a model to a product’s real data and actions through a few narrow tools, so it acts instead of guessing and can recover when a step fails.'],
  ['A budget for every call', 'The chat, extraction and matching features I ship each have a time limit, a cost limit and a fallback, so a person always gets an answer.'],
  ['Tested before trusted', 'Every change to a prompt or a model runs against past failures first, so a mistake is caught by a test and not by a user.'],
  ['Agents on the team', 'I work with coding agents every day under written rules: small changes, each one checked in a real browser before I call it done.'],
];
// Experience: the day jobs, newest first. Real titles only, and the one place an employer is named (AGENTS.md).
const jobs = [
  { when: 'Now', role: `${SITE.role}, swipejobs`, text: 'A platform that matches workers with jobs. I build its web apps.' },
  {
    when: '2020',
    role: `Frontend Engineer, ${SITE.previousCompany}`,
    text: 'A product that helps websites turn more visitors into customers. I built and maintained its web app.',
  },
];
const mark =
  '<path d="M8.66 5 17.32 10v10l-8.66 5L0 20V10z" fill-opacity=".45"></path><path d="M17.32 10l8.66 5v10l-8.66 5-8.66-5V15z" fill-opacity=".65"></path><path d="M17.32 0l8.66 5v10l-8.66 5-8.66-5V5z" fill-opacity=".8"></path>';
// Who this is, for search engines and agents (schema.org). The job title is the real one; no employer here.
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE.name,
  url: SITE.url,
  jobTitle: SITE.role,
  description: SITE.description,
  email: `mailto:${SITE.email}`,
  address: { '@type': 'PostalAddress', addressLocality: 'New Delhi', addressCountry: 'IN' },
  sameAs: Object.values(SITE.socials),
};
---

<BaseLayout splash jsonLd={person}>
  <section class="hero" id="about" aria-labelledby="h1">
    <div class="art" aria-hidden="true"><Doodle /></div>
    <div class="hero-text">
      <h1 id="h1">
        <span class="name rise" style="--d:120">{SITE.name}<span class="sr-only">,</span></span>
        <span class="st rise" style="--d:190">Software you don’t <br />have to think about.</span>
      </h1>
      <div class="intro">
        <p class="rise" style="--d:300">
          I’m a software engineer in New Delhi. I’ve been building web and native apps since {SITE.since}, along with
          the backends behind them and the infrastructure they run on.
        </p>
        <p class="rise" style="--d:340">
          These days most of my time goes to putting language models to work inside real products. The goal hasn’t
          changed: <span class="hl">software that’s fast to load, clear to use and boring to run</span>.
        </p>
      </div>
      <p class="aside rise" style="--d:380">
        Off screen: astronomy, rockets, physics and sport. The drawing covers three of the four.
      </p>
      <p class="reach rise" style="--d:420">
        Write to me at <a class="ul" href={`mailto:${SITE.email}`}>{SITE.email}</a>.
      </p>
    </div>
  </section>

  <section class="sec now" id="now" aria-labelledby="now-h">
    <div>
      <h2 class="h2" id="now-h">How I work</h2>
      <p class="note">Where most of my week goes.</p>
    </div>
    <div>
      <p class="thesis">The model is rarely the hard part. Everything around it is.</p>
      <ul class="parts">
        {
          now.map(([h, p]) => (
            <li>
              <h3>{h}</h3>
              <p>{p}</p>
            </li>
          ))
        }
      </ul>
      <p class="soon">
        <span>Coming soon</span>Orca, a timer for the macOS menu bar that you and an AI agent can both run.
      </p>
    </div>
  </section>

  <section class="sec split" id="experience" aria-labelledby="xp-h">
    <div class="head">
      <h2 class="h2" id="xp-h">Experience</h2>
      <p class="note">The day jobs, newest first.</p>
    </div>
    <ol class="list">
      {
        jobs.map((j) => (
          <li class="job">
            <span class="pm">{j.when}</span>
            <h3 class="pn">{j.role}</h3>
            <p class="cs">{j.text}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="sec split" id="writing" aria-labelledby="writing-h">
    <div class="head">
      <h2 class="h2" id="writing-h">Writing</h2>
      <p class="note">Notes on building for the web, and the problems I would rather solve once.</p>
      <div class="sk" aria-hidden="true"><Doodle art="writing" /></div>
    </div>
    <div class="list">
      <ul>
        {
          posts.map((p) => (
            <li>
              <PostCard post={p} />
            </li>
          ))
        }
      </ul>
      <a class="all" href="/writing">Read all {all.length} posts<span aria-hidden="true">→</span></a>
    </div>
  </section>

  <section class="sec split" id="projects" aria-labelledby="projects-h">
    <div class="head">
      <h2 class="h2" id="projects-h">Projects</h2>
      <p class="note">Tools I built for my own problems, then released.</p>
      <div class="sk" aria-hidden="true"><Doodle art="projects" /></div>
    </div>
    <ul class="list">
      {
        work.map((w) => (
          <li>
            <a
              class="proj"
              href={w.href}
              rel="noopener"
              target="_blank"
              aria-label={`${w.name}: ${w.go} (opens in a new tab)`}
              aria-describedby={`pj-${w.id}`}
            >
              <span class="pj">
                <span class="pm">
                  {w.kind}, {w.year}
                </span>
                <span class="pn">{w.name}</span>
                <span class="cs" id={`pj-${w.id}`}>
                  {w.summary}
                </span>
                <span class="go">{w.go}</span>
              </span>
              <span class="still" aria-hidden="true">
                <span class="st-in">
                  {w.id === 'tooltip' && (
                    <>
                      <span class="tt" data-tip="Saved">
                        Save changes
                      </span>
                      <code class="tt-code">&lt;button data-tooltip="Saved"&gt;</code>
                    </>
                  )}
                  {w.id === 'diver' && (
                    <span class="dv">
                      <span class="dv-top">
                        <span>rajiv.me</span>
                        <span class="dv-nav">
                          <span>About</span>
                          <span>Writing</span>
                        </span>
                      </span>
                      <span class="dv-h">Software you don’t have to think about.</span>
                      <span>I’m a software engineer.</span>
                    </span>
                  )}
                  {w.id === 'yt' && (
                    <span class="yt">
                      <span class="yt-total">11:42:37</span>
                      <span class="yt-cap">Total watch time, 64 videos</span>
                      <span class="yt-list">
                        <span>Kepler’s laws of motion</span>
                        <span>18:24</span>
                        <span>Orbits and escape velocity</span>
                        <span>21:10</span>
                        <span>The Hohmann transfer</span>
                        <span>16:52</span>
                      </span>
                    </span>
                  )}
                  {w.id === 'site' && <svg class="mk" viewBox="-2.01 0 30 30" fill="#ff5f1f" set:html={mark}></svg>}
                </span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>

<script>
  // Scroll spy for the header nav: the section crossing the middle of the screen is the active one. Now and
  // Experience count as About and the footer as Projects, so a jump to the end still lands there.
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-spy]')];
  const foot = document.querySelector('footer');
  const spy = new IntersectionObserver(
    (entries) =>
      entries.forEach((e) => {
        if (!e.isIntersecting) return;
        const id = e.target === foot ? 'projects' : ['now', 'experience'].includes(e.target.id) ? 'about' : e.target.id;
        links.forEach((a) => {
          const on = a.dataset.spy === id;
          a.classList.toggle('on', on);
          if (on) a.setAttribute('aria-current', 'true');
          else a.removeAttribute('aria-current');
        });
      }),
    { rootMargin: '-45% 0px -54% 0px' },
  );
  ['about', 'now', 'experience', 'writing', 'projects'].forEach((id) => {
    const s = document.getElementById(id);
    if (s) spy.observe(s);
  });
  if (foot) spy.observe(foot);
</script>

<style>
  /* Landing: the frame (text left, doodle right) is global.css's `.hero`, shared with the 404. */
  h1 {
    font-weight: 500;
  }
  .name {
    display: block;
    font-size: var(--t-m);
    line-height: 1.2;
    letter-spacing: -0.015em;
    color: var(--accent);
  }
  .st {
    display: block;
    margin-top: 16px;
    font-size: var(--t-xl);
    line-height: 0.98;
    letter-spacing: -0.045em;
  }
  /* About in two short paragraphs, then a muted line with the person and the ways to reach him. */
  .intro {
    max-width: 31em;
    margin-top: 44px;
    font-size: var(--t-sm);
    line-height: 1.45;
    letter-spacing: -0.01em;
    text-wrap: pretty;
  }
  .intro p + p {
    margin-top: 16px;
  }
  /* The values phrase reads as plain text until the pointer is on the paragraphs. Then the orange flows through it
     left to right, line after line (the gradient spans the phrase as one strip), and ebbs back on leave. */
  .hl {
    background: linear-gradient(90deg, var(--accent) 40%, var(--ink) 60%) 100% 0 / 250% 100% no-repeat;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  @media (prefers-reduced-motion: no-preference) {
    .hl {
      transition: background-position 1100ms var(--ease);
    }
  }
  @media (hover: hover) {
    .intro:hover .hl {
      background-position: 0 0;
    }
  }
  /* The person in one muted line, then how to reach him in --ink with the address spelled out. */
  .aside,
  .reach {
    max-width: 42em;
    text-wrap: pretty;
  }
  .aside {
    margin-top: 20px;
    color: var(--muted);
    text-wrap: balance;
  }
  .reach {
    margin-top: 12px;
  }
  .sec {
    padding-top: 136px;
  }
  /* Now: the h2 in the first column; from the axis (in line with the header nav) the thesis, its four parts in two
     columns on hairlines, then what ships next. */
  .now {
    display: grid;
    grid-template-columns: var(--cols);
    align-items: baseline;
  }
  .thesis {
    max-width: 18em;
    font-size: var(--t-l);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  .parts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 40px;
    margin-top: 48px;
  }
  .parts li {
    padding-top: 16px;
    border-top: 1px solid var(--line);
  }
  h3 {
    font-weight: 500;
    letter-spacing: -0.01em;
  }
  .parts p {
    margin-top: 6px;
    color: var(--muted);
    text-wrap: pretty;
  }
  .soon {
    max-width: 38em;
    margin-top: 48px;
    color: var(--muted);
    text-wrap: pretty;
  }
  .soon span {
    margin-right: 12px;
    color: var(--accent);
  }
  @media (max-width: 999px) {
    .now {
      display: block;
    }
    .thesis {
      margin-top: 24px;
    }
  }
  /* Writing and Projects: the h2 and its note in the first column, sticky, the rows from the axis like Now's. */
  .split {
    display: grid;
    grid-template-columns: var(--cols);
    align-items: start;
  }
  .split .head {
    position: sticky;
    top: calc(var(--head-h) + 40px);
    padding-right: clamp(32px, 4.4vw, 72px);
  }
  @media (max-width: 999px) {
    .split {
      display: block;
    }
    .split .head {
      position: static;
    }
    .list {
      margin-top: 32px;
    }
  }
  .h2 {
    font-size: var(--t-l);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }
  .note {
    max-width: 22em;
    margin-top: 12px;
    color: var(--muted);
    text-wrap: pretty;
  }
  /* Under the note, the section's doodle: its story in three objects on a dashed route, a pencil sketch in --muted
     that a mouse over this box inks and sets moving (Doodle.astro). Under 1000px it sits small under the note, so the
     drawings carry on past the landing; on touch it shows inked (Doodle.astro). */
  .sk {
    width: min(100%, 300px);
    height: clamp(180px, 100svh - var(--head-h) - 420px, 270px);
    margin-top: 56px;
  }
  @media (max-width: 999px) {
    .sk {
      width: 200px;
      height: 130px;
      margin-top: 28px;
    }
  }
  /* After the post rows, the way to the rest: a row of its own, the arrow in orange. */
  .all {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding-block: 22px;
    border-block: 1px solid var(--line);
    font-size: var(--t-sm);
    font-weight: 500;
    letter-spacing: -0.015em;
    transition: color 200ms var(--ease);
  }
  @media (hover: hover) {
    .all:hover {
      color: var(--accent);
    }
  }
  .all:focus-visible {
    color: var(--accent);
  }
  .all span {
    color: var(--accent);
  }
  @media (prefers-reduced-motion: no-preference) {
    .all span {
      transition: translate 200ms var(--ease);
    }
    .all:hover span {
      translate: 6px 0;
    }
  }
  /* An experience row, in the post rows' order: when, the role, one plain line about the work. */
  .job {
    padding-block: 24px;
    border-top: 1px solid var(--line);
  }
  .job .pn {
    margin-top: 8px;
  }
  .job .cs {
    max-width: 38em;
  }
  /* A project row: the text on the left, the still on the right with the larger share. */
  .proj {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
    gap: 32px;
    align-items: start;
    padding-block: 28px;
    border-top: 1px solid var(--line);
  }
  .pm {
    display: block;
    font-size: var(--t-xs);
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .pn {
    display: block;
    margin-top: 10px;
    font-size: var(--t-sm);
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: -0.015em;
    transition: color 200ms var(--ease);
  }
  /* Every clickable item's title turns orange while the pointer is anywhere on the item, or it has keyboard focus. */
  @media (hover: hover) {
    .proj:hover .pn {
      color: var(--accent);
    }
  }
  .proj:focus-visible .pn {
    color: var(--accent);
  }
  .cs {
    display: block;
    margin-top: 8px;
    color: var(--muted);
    text-wrap: pretty;
  }
  .go {
    display: inline-block;
    margin-top: 16px;
    font-size: var(--t-xs);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.22em;
  }
  .proj:hover .go {
    text-decoration-thickness: 2px;
  }
  .still {
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--panel);
  }

  /* Stills: each project drawn in HTML, a small illustration set at its own sizes and scaled to the still's width. */
  .still {
    container-type: inline-size;
  }
  .st-in {
    display: grid;
    justify-items: center;
    scale: 1.35;
    font-size: 14px;
    line-height: 1.4;
  }
  @container (max-width: 420px) {
    .st-in {
      scale: 1;
    }
  }
  /* css-only-tooltip, built the way the library builds it: a data attribute and two pseudo-elements. */
  .tt {
    position: relative;
    margin-top: 30px;
    padding: 9px 14px;
    border-radius: 6px;
    background: var(--bg);
    font-weight: 500;
  }
  .tt::after {
    content: attr(data-tip);
    position: absolute;
    left: 50%;
    bottom: calc(100% + 10px);
    translate: -50% 0;
    padding: 4px 9px;
    border-radius: 5px;
    background: var(--ink);
    color: var(--bg);
    font-size: 13px;
    white-space: nowrap;
  }
  .tt::before {
    content: '';
    position: absolute;
    left: 50%;
    bottom: calc(100% + 5px);
    translate: -50% 0;
    border: 5px solid transparent;
    border-bottom: 0;
    border-top-color: var(--ink);
  }
  .tt-code {
    margin-top: 22px;
    font-family: var(--mono);
    font-size: 12px;
    color: var(--muted);
  }
  /* Diver: every element outlined. */
  .dv {
    display: grid;
    gap: 7px;
    width: 210px;
    padding: 10px;
    background: var(--bg);
    font-size: 11px;
    line-height: 1.3;
  }
  .dv,
  .dv * {
    outline: 1px solid var(--accent);
  }
  .dv-top {
    display: flex;
    justify-content: space-between;
  }
  .dv-nav {
    display: flex;
    gap: 6px;
  }
  .dv-h {
    margin-top: 8px;
    font-size: 17px;
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.03em;
  }
  /* YouTube Playlist Info: the total, then the videos that add up to it. */
  .yt {
    display: grid;
    width: 210px;
    font-size: 12px;
  }
  .yt-total {
    font-size: 26px;
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
  }
  .yt-cap,
  .yt-list > :nth-child(even) {
    color: var(--muted);
  }
  .yt-list {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 5px 12px;
    margin-top: 12px;
    font-variant-numeric: tabular-nums;
  }
  .mk {
    width: 72px;
    height: 72px;
    fill: var(--logo);
  }

  /* Phone: one column everywhere, stills above their text. */
  @media (max-width: 720px) {
    .st {
      margin-top: 12px;
      line-height: 1;
      letter-spacing: -0.04em;
      text-wrap: balance;
    }
    .st br {
      display: none;
    }
    .intro {
      margin-top: 28px;
    }
    .sec {
      padding-top: 104px;
    }
    #now {
      padding-top: 72px;
    }
    /* Three posts on a phone; /writing has the rest. */
    #writing li:nth-child(n + 4) {
      display: none;
    }
    .still {
      aspect-ratio: 2 / 1;
    }
    .parts {
      grid-template-columns: minmax(0, 1fr);
      gap: 28px;
      margin-top: 36px;
    }
    .soon {
      margin-top: 36px;
    }
    .proj {
      grid-template-columns: minmax(0, 1fr);
      gap: 20px;
      padding-block: 28px;
    }
    .still {
      order: -1;
    }
  }
</style>
