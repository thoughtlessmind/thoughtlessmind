---
import BaseLayout from '../layouts/BaseLayout.astro';
import Doodle from '../components/Doodle.astro';
import PostCard from '../components/PostCard.astro';
import { SITE } from '../consts';
import { getPosts } from '../lib/writing';

// Each project links to the real thing; `go` says where. The stills are drawn in HTML below (DESIGN.md §5).
const work = [
  {
    id: 'tooltip',
    name: 'css-only-tooltip',
    kind: 'Library',
    year: 2021,
    summary: 'A tooltip library with no JavaScript. Data attributes in, tooltip out, with light and dark themes and nothing to bundle.',
    go: 'View on npm',
    href: 'https://www.npmjs.com/package/css-only-tooltip',
  },
  {
    id: 'diver',
    name: 'Diver',
    kind: 'Chrome extension',
    year: 2023,
    summary: 'Outlines every element on a page in one click, so you can see the boxes, nesting and spacing of a layout you didn’t write.',
    go: 'Chrome Web Store',
    href: 'https://chrome.google.com/webstore/detail/diver/onfnfdmnccoaknhjinebmlncejnofhoc',
  },
  {
    id: 'yt',
    name: 'YouTube Playlist Info',
    kind: 'Web app',
    year: 2020,
    summary: 'Paste a playlist link and see how long it really takes to watch, video by video, before you commit to it.',
    go: 'Open the app',
    href: 'https://youtube-playlist-info.netlify.app',
  },
  {
    id: 'site',
    name: 'rajiv.me',
    kind: 'This site',
    year: 2026,
    summary: 'Static pages, one hand-built intro and zero work once it has loaded. Every post is also served as Markdown, so agents can read it too.',
    go: 'Read the source',
    href: `${SITE.socials.github}/thoughtlessmind`,
  },
];
// The four newest posts; /writing has the rest.
const all = await getPosts();
const posts = all.slice(0, 4);
// Now: one line on the problem, then the four parts of the answer (DESIGN.md §5).
const now = [
  ['Tools, not paragraphs', 'MCP servers that give a model typed access to a product’s real data and actions, with errors it can recover from.'],
  ['A budget for every call', 'Chat, extraction and matching features real people use, each with a time and cost limit and a fallback that always answers.'],
  ['Evals before vibes', 'Checks on every prompt and model change, so a regression fails a test before it reaches a user.'],
  ['Agents on the team', 'Coding agents in my daily work, with skills, hooks and review loops that keep every diff small and verified.'],
];
const mark =
  '<path d="M8.66 5 17.32 10v10l-8.66 5L0 20V10z" fill-opacity=".45"></path><path d="M17.32 10l8.66 5v10l-8.66 5-8.66-5V15z" fill-opacity=".65"></path><path d="M17.32 0l8.66 5v10l-8.66 5-8.66-5V5z" fill-opacity=".8"></path>';
---

<BaseLayout splash>
  <section class="hero" id="about" aria-labelledby="h1">
    <div class="art" aria-hidden="true"><Doodle /></div>
    <div class="hero-text">
      <h1 id="h1">
        <span class="name rise" style="--d:120">{SITE.name}<span class="sr-only">,</span></span>
        <span class="st rise" style="--d:190">Software you don’t <br />have to think about.</span>
      </h1>
      <div class="intro">
        <p class="rise" style="--d:300">
          I’m a software engineer. I’ve been building web and native apps since {SITE.since}, along with the backends
          behind them and the infrastructure they run on.
        </p>
        <p class="rise" style="--d:340">
          These days most of my time goes to putting language models to work inside real products. The goal hasn’t
          changed: <span class="hl">software that’s fast to load, clear to use and boring to run</span>.
        </p>
      </div>
      <p class="aside rise" style="--d:380">
        Off screen: astronomy, rockets, physics and sport. Say hello by <a class="ul" href={`mailto:${SITE.email}`}
          >email</a
        >, or find me on <a class="ul" href={SITE.socials.github} rel="me">GitHub</a>, <a
          class="ul"
          href={SITE.socials.linkedin}
          rel="me">LinkedIn</a
        > and <a class="ul" href={SITE.socials.x} rel="me">X</a>.
      </p>
    </div>
  </section>

  <section class="sec now" id="now" aria-labelledby="now-h">
    <h2 class="h2" id="now-h">Now</h2>
    <div>
      <p class="thesis">The model is rarely the hard part. Everything around it is.</p>
      <ul class="parts">
        {
          now.map(([h, p]) => (
            <li>
              <h3>{h}</h3>
              <p>{p}</p>
            </li>
          ))
        }
      </ul>
      <p class="soon">
        <span>Coming soon</span>Orca, a macOS menu bar timer that you and an agent drive together over MCP.
      </p>
    </div>
  </section>

  <section class="sec split" id="writing" aria-labelledby="writing-h">
    <div class="head">
      <h2 class="h2" id="writing-h">Writing</h2>
      <p class="note">Notes on putting models to work and building for the web.</p>
      <div class="sk" aria-hidden="true"><Doodle art="writing" /></div>
    </div>
    <div class="list">
      <ul>
        {
          posts.map((p) => (
            <li>
              <PostCard post={p} />
            </li>
          ))
        }
      </ul>
      <a class="all" href="/writing">Read all {all.length} posts<span aria-hidden="true">→</span></a>
    </div>
  </section>

  <section class="sec split" id="projects" aria-labelledby="projects-h">
    <div class="head">
      <h2 class="h2" id="projects-h">Projects</h2>
      <p class="note">Tools I built for my own problems, then released.</p>
      <div class="sk" aria-hidden="true"><Doodle art="projects" /></div>
    </div>
    <ul class="list">
      {
        work.map((w) => (
          <li>
            <a class="proj" href={w.href} rel="noopener" target="_blank">
              <span class="pj">
                <span class="pm">
                  {w.kind}, {w.year}
                </span>
                <span class="pn">{w.name}</span>
                <span class="cs">{w.summary}</span>
                <span class="go">{w.go}</span>
              </span>
              <span class="still" aria-hidden="true">
                <span class="st-in">
                  {w.id === 'tooltip' && (
                    <>
                      <span class="tt" data-tip="Saved">
                        Save changes
                      </span>
                      <code class="tt-code">&lt;button data-tooltip="Saved"&gt;</code>
                    </>
                  )}
                  {w.id === 'diver' && (
                    <span class="dv">
                      <span class="dv-top">
                        <span>rajiv.me</span>
                        <span class="dv-nav">
                          <span>About</span>
                          <span>Writing</span>
                        </span>
                      </span>
                      <span class="dv-h">Software you don’t have to think about.</span>
                      <span>I’m a software engineer.</span>
                    </span>
                  )}
                  {w.id === 'yt' && (
                    <span class="yt">
                      <span class="yt-total">11:42:37</span>
                      <span class="yt-cap">Total watch time, 64 videos</span>
                      <span class="yt-list">
                        <span>Kepler’s laws of motion</span>
                        <span>18:24</span>
                        <span>Orbits and escape velocity</span>
                        <span>21:10</span>
                        <span>The Hohmann transfer</span>
                        <span>16:52</span>
                      </span>
                    </span>
                  )}
                  {w.id === 'site' && <svg class="mk" viewBox="-2.01 0 30 30" fill="#ff5f1f" set:html={mark}></svg>}
                </span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>

<script>
  // Scroll spy for the header nav: the section crossing the middle of the screen is the active one. Now counts as
  // About and the footer as Projects, so a jump to the end still lands there.
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-spy]')];
  const foot = document.querySelector('footer');
  const spy = new IntersectionObserver(
    (entries) =>
      entries.forEach((e) => {
        if (!e.isIntersecting) return;
        const id = e.target === foot ? 'projects' : e.target.id === 'now' ? 'about' : e.target.id;
        links.forEach((a) => {
          const on = a.dataset.spy === id;
          a.classList.toggle('on', on);
          if (on) a.setAttribute('aria-current', 'true');
          else a.removeAttribute('aria-current');
        });
      }),
    { rootMargin: '-45% 0px -54% 0px' },
  );
  ['about', 'now', 'writing', 'projects'].forEach((id) => {
    const s = document.getElementById(id);
    if (s) spy.observe(s);
  });
  if (foot) spy.observe(foot);
</script>

<style>
  /* Landing: about me on the left, the doodle on the right 48%. It runs to the right edge of the screen and clips
     the doodle there. */
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    min-height: clamp(640px, 100vh, 960px);
    margin-right: calc(-1 * var(--gut-r));
    padding-block: 112px 56px;
    overflow-x: clip;
  }
  .hero-text {
    position: relative;
    z-index: 1;
    width: min(760px, 52vw);
  }
  h1 {
    font-weight: 500;
  }
  .name {
    display: block;
    font-size: var(--t-m);
    line-height: 1.2;
    letter-spacing: -0.015em;
    color: var(--accent);
  }
  .st {
    display: block;
    margin-top: 16px;
    font-size: var(--t-xl);
    line-height: 0.98;
    letter-spacing: -0.045em;
  }
  /* About in two short paragraphs, then a muted line with the person and the ways to reach him. */
  .intro {
    max-width: 31em;
    margin-top: 44px;
    font-size: var(--t-sm);
    line-height: 1.45;
    letter-spacing: -0.01em;
    text-wrap: pretty;
  }
  .intro p + p {
    margin-top: 16px;
  }
  /* The values phrase reads as plain text until the pointer is on the paragraphs. Then the orange flows through it
     left to right, line after line (the gradient spans the phrase as one strip), and ebbs back on leave. */
  .hl {
    background: linear-gradient(90deg, var(--accent) 40%, var(--ink) 60%) 100% 0 / 250% 100% no-repeat;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  @media (prefers-reduced-motion: no-preference) {
    .hl {
      transition: background-position 1100ms var(--ease);
    }
  }
  @media (hover: hover) {
    .intro:hover .hl {
      background-position: 0 0;
    }
  }
  .aside {
    max-width: 36em;
    margin-top: 20px;
    color: var(--muted);
    text-wrap: pretty;
  }
  /* Its links sit in --ink on the muted line, which outranks the global link hover, so they repeat it here. */
  .aside a {
    color: var(--ink);
  }
  @media (hover: hover) {
    .aside a:hover {
      color: var(--accent);
    }
  }
  .aside a:focus-visible {
    color: var(--accent);
  }
  .art {
    position: absolute;
    inset: 0 0 0 auto;
    width: 48vw;
    padding: 96px 56px 40px 0;
    pointer-events: none;
  }

  .sec {
    padding-top: 136px;
  }
  /* Now: the h2 in the first column; from the axis (in line with the header nav) the thesis, its four parts in two
     columns on hairlines, then what ships next. */
  .now {
    display: grid;
    grid-template-columns: var(--cols);
    align-items: baseline;
  }
  .thesis {
    max-width: 18em;
    font-size: var(--t-l);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  .parts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 40px;
    margin-top: 48px;
  }
  .parts li {
    padding-top: 16px;
    border-top: 1px solid var(--line);
  }
  h3 {
    font-weight: 500;
    letter-spacing: -0.01em;
  }
  .parts p {
    margin-top: 6px;
    color: var(--muted);
    text-wrap: pretty;
  }
  .soon {
    margin-top: 48px;
    color: var(--muted);
  }
  .soon span {
    margin-right: 12px;
    color: var(--accent);
  }
  @media (max-width: 999px) {
    .now {
      display: block;
    }
    .thesis {
      margin-top: 24px;
    }
  }
  /* Writing and Projects: the h2 and its note in the first column, sticky, the rows from the axis like Now's. */
  .split {
    display: grid;
    grid-template-columns: var(--cols);
    align-items: start;
  }
  .split .head {
    position: sticky;
    top: calc(var(--head-h) + 40px);
    padding-right: clamp(32px, 4.4vw, 72px);
  }
  @media (max-width: 999px) {
    .split {
      display: block;
    }
    .split .head {
      position: static;
    }
    .list {
      margin-top: 32px;
    }
  }
  .h2 {
    font-size: var(--t-l);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }
  .note {
    max-width: 22em;
    margin-top: 12px;
    color: var(--muted);
    text-wrap: pretty;
  }
  /* Under the note, the section's doodle: its story in three objects on a dashed route, in --muted, hidden until a
     mouse over this box carries the blob that shows it. Phones skip it: there the rows follow the head. */
  .sk {
    width: min(100%, 300px);
    height: clamp(180px, 100svh - var(--head-h) - 420px, 270px);
    margin-top: 56px;
  }
  .sk :global(.doodle) {
    color: var(--muted);
  }
  @media (max-width: 999px) {
    .sk {
      display: none;
    }
  }
  /* After the post rows, the way to the rest: a row of its own, the arrow in orange. */
  .all {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding-block: 22px;
    border-block: 1px solid var(--line);
    font-size: var(--t-sm);
    font-weight: 500;
    letter-spacing: -0.015em;
    transition: color 200ms var(--ease);
  }
  @media (hover: hover) {
    .all:hover {
      color: var(--accent);
    }
  }
  .all:focus-visible {
    color: var(--accent);
  }
  .all span {
    color: var(--accent);
  }
  @media (prefers-reduced-motion: no-preference) {
    .all span {
      transition: translate 200ms var(--ease);
    }
    .all:hover span {
      translate: 6px 0;
    }
  }
  /* A project row: the text on the left, the still on the right with the larger share. */
  .proj {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
    gap: 32px;
    align-items: start;
    padding-block: 28px;
    border-top: 1px solid var(--line);
  }
  .pm {
    display: block;
    font-size: var(--t-xs);
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .pn {
    display: block;
    margin-top: 10px;
    font-size: var(--t-sm);
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: -0.015em;
    transition: color 200ms var(--ease);
  }
  /* Every clickable item's title turns orange while the pointer is anywhere on the item, or it has keyboard focus. */
  @media (hover: hover) {
    .proj:hover .pn {
      color: var(--accent);
    }
  }
  .proj:focus-visible .pn {
    color: var(--accent);
  }
  .cs {
    display: block;
    margin-top: 8px;
    color: var(--muted);
    text-wrap: pretty;
  }
  .go {
    display: inline-block;
    margin-top: 16px;
    font-size: var(--t-xs);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.22em;
  }
  .proj:hover .go {
    text-decoration-thickness: 2px;
  }
  .still {
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--panel);
  }

  /* Stills: each project drawn in HTML, a small illustration set at its own sizes and scaled to the still's width. */
  .still {
    container-type: inline-size;
  }
  .st-in {
    display: grid;
    justify-items: center;
    scale: 1.35;
    font-size: 14px;
    line-height: 1.4;
  }
  @container (max-width: 420px) {
    .st-in {
      scale: 1;
    }
  }
  /* css-only-tooltip, built the way the library builds it: a data attribute and two pseudo-elements. */
  .tt {
    position: relative;
    margin-top: 30px;
    padding: 9px 14px;
    border-radius: 6px;
    background: var(--bg);
    font-weight: 500;
  }
  .tt::after {
    content: attr(data-tip);
    position: absolute;
    left: 50%;
    bottom: calc(100% + 10px);
    translate: -50% 0;
    padding: 4px 9px;
    border-radius: 5px;
    background: var(--ink);
    color: var(--bg);
    font-size: 13px;
    white-space: nowrap;
  }
  .tt::before {
    content: '';
    position: absolute;
    left: 50%;
    bottom: calc(100% + 5px);
    translate: -50% 0;
    border: 5px solid transparent;
    border-bottom: 0;
    border-top-color: var(--ink);
  }
  .tt-code {
    margin-top: 22px;
    font-family: var(--mono);
    font-size: 12px;
    color: var(--muted);
  }
  /* Diver: every element outlined. */
  .dv {
    display: grid;
    gap: 7px;
    width: 210px;
    padding: 10px;
    background: var(--bg);
    font-size: 11px;
    line-height: 1.3;
  }
  .dv,
  .dv * {
    outline: 1px solid var(--accent);
  }
  .dv-top {
    display: flex;
    justify-content: space-between;
  }
  .dv-nav {
    display: flex;
    gap: 6px;
  }
  .dv-h {
    margin-top: 8px;
    font-size: 17px;
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.03em;
  }
  /* YouTube Playlist Info: the total, then the videos that add up to it. */
  .yt {
    display: grid;
    width: 210px;
    font-size: 12px;
  }
  .yt-total {
    font-size: 26px;
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
  }
  .yt-cap,
  .yt-list > :nth-child(even) {
    color: var(--muted);
  }
  .yt-list {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 5px 12px;
    margin-top: 12px;
    font-variant-numeric: tabular-nums;
  }
  .mk {
    width: 72px;
    height: 72px;
    fill: var(--logo);
  }

  /* Phone: the doodle in a band under the header, the text under it; one column everywhere, stills above their text. */
  @media (max-width: 720px) {
    .hero {
      display: block;
      min-height: 0;
      margin-right: 0;
      padding-block: 300px 48px;
    }
    .hero-text {
      width: auto;
    }
    .art {
      inset: 76px 0 auto;
      width: auto;
      height: 208px;
      padding: 0;
    }
    .art :global(.doodle) {
      --k: 1.8;
    }
    .st {
      margin-top: 12px;
      line-height: 1;
      letter-spacing: -0.04em;
      text-wrap: balance;
    }
    .st br {
      display: none;
    }
    .intro {
      margin-top: 28px;
    }
    .sec {
      padding-top: 104px;
    }
    .parts {
      grid-template-columns: minmax(0, 1fr);
      gap: 28px;
      margin-top: 36px;
    }
    .soon {
      margin-top: 36px;
    }
    .proj {
      grid-template-columns: minmax(0, 1fr);
      gap: 20px;
      padding-block: 28px;
    }
    .still {
      order: -1;
    }
  }
</style>
