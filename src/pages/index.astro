---
import BaseLayout from '../layouts/BaseLayout.astro';
import Doodle from '../components/Doodle.astro';
import PostCard from '../components/PostCard.astro';
import { SITE } from '../consts';
import swipejobs from '../assets/logos/swipejobs.png';
import influence from '../assets/logos/influence.png';
import { cover, getPosts } from '../lib/blogs';

// Each project links to the real thing; `go` says where. `from`/`to` are the years it was worked on (first release to
// last update, from the Chrome Web Store, npm and GitHub); `to` is null while it is still active. The stills are drawn in HTML below (DESIGN.md §5).
// The tools newest first, then this site as the colophon.
const work = [
  {
    id: 'diver',
    name: 'Diver',
    kind: 'Chrome extension',
    from: 2023,
    to: 2025,
    summary: 'Outlines every element on a page in one click, so you can see the boxes, nesting and spacing of a layout you didn’t write.',
    go: 'Get it for Chrome',
    href: 'https://chrome.google.com/webstore/detail/diver/onfnfdmnccoaknhjinebmlncejnofhoc',
  },
  {
    id: 'tooltip',
    name: 'css-only-tooltip',
    kind: 'Library',
    from: 2021,
    to: 2023,
    summary: 'A tooltip library with no JavaScript. Data attributes in, tooltip out, with light and dark themes and nothing to bundle.',
    go: 'View on npm',
    href: 'https://www.npmjs.com/package/css-only-tooltip',
  },
  {
    id: 'yt',
    name: 'YouTube Playlist Info',
    kind: 'Web app',
    from: 2020,
    to: 2025,
    summary: 'Paste a playlist link and see how long it really takes to watch, video by video, before you commit to it.',
    go: 'Open the app',
    href: 'https://youtube-playlist-info.netlify.app',
  },
  {
    id: 'site',
    name: 'rajiv.me',
    kind: 'This site',
    from: 2026,
    to: null,
    summary: 'Static pages, a drawing that draws itself and nothing running in the background once it has loaded. Every post is also served as Markdown, so AI tools can read it too.',
    go: 'Read the source',
    href: `${SITE.socials.github}/thoughtlessmind`,
  },
];
// The four newest posts that have a cover drawing; /blogs has the rest. The four newest of all were four Material
// UI answers, two of them without a drawing. A new post shows here once its cover is drawn.
const all = await getPosts();
const posts = all.filter((p) => cover(p.id)).slice(0, 4);
// Now: one line on the problem, then the four parts of the answer, each in words a non-engineer can follow. The
// posts on these topics, once written, carry the technical detail (DESIGN.md §5).
const now = [
  ['Tools, not paragraphs', 'I connect a model to a product’s real data and actions through a few narrow tools, so it acts instead of guessing and can recover when a step fails.'],
  ['A budget for every call', 'The chat, extraction and matching features I ship each have a time limit, a cost limit and a fallback, so a person always gets an answer.'],
  ['Tested before trusted', 'Every change to a prompt or a model runs against past failures first, so a mistake is caught by a test and not by a user.'],
  ['Agents on the team', 'I work with coding agents every day under written rules: small changes, each one checked in a real browser before I call it done.'],
];
// Experience: the day jobs, newest first, as a timeline. Real titles and dates only, and the one place an employer is
// named (AGENTS.md). `from`/`to` are ISO months for <time>; `to` is empty while the job is current. The logos are
// imported assets shown as plain <img>: the project has no Sharp, and two tiny PNGs need no resizing. `work` is a few
// lines on what he built there and the problem it solved.
// `work` is empty until he writes the real lines (no placeholder text on the page); the list shows once it has any.
const jobs = [
  {
    from: ['2021-08', 'Aug 2021'],
    to: null,
    role: SITE.role,
    company: 'swipejobs',
    logo: swipejobs,
    pad: 8,
    text: 'A platform that matches workers with jobs. I build its web apps.',
    work: [] as string[],
  },
  {
    from: ['2020-01', 'Jan 2020'],
    to: ['2021-07', 'Jul 2021'],
    role: 'Frontend Engineer',
    company: SITE.previousCompany,
    logo: influence,
    pad: 5,
    text: 'A product that helps websites turn more visitors into customers. I built and maintained its web app.',
    work: [] as string[],
  },
];
const mark =
  '<path d="M8.66 5 17.32 10v10l-8.66 5L0 20V10z" fill-opacity=".45"></path><path d="M17.32 10l8.66 5v10l-8.66 5-8.66-5V15z" fill-opacity=".65"></path><path d="M17.32 0l8.66 5v10l-8.66 5-8.66-5V5z" fill-opacity=".8"></path>';
// Who this is, for search engines and agents (schema.org). The job title is the real one; no employer here.
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE.name,
  url: SITE.url,
  jobTitle: SITE.role,
  description: SITE.description,
  email: `mailto:${SITE.email}`,
  address: { '@type': 'PostalAddress', addressLocality: 'New Delhi', addressCountry: 'IN' },
  sameAs: Object.values(SITE.socials),
};
---

<BaseLayout splash jsonLd={person}>
  <section class="hero" id="about" aria-labelledby="h1">
    <div class="hero-text">
      <h1 id="h1">
        <span class="name rise" style="--d:120" data-hero-name>{SITE.name}<span class="sr-only">,</span></span>
        <span class="st rise" style="--d:190">Software you don’t <br />have to think about.</span>
      </h1>
      <p class="intro rise" style="--d:300">
        A software engineer in New Delhi, building web and native apps, their backends and the infrastructure under
        them since {SITE.since}. Lately, language models inside real products. The aim stays the
        same: <span class="hl">fast to load, clear to use, boring to run</span>.
      </p>
      <p class="reach rise" style="--d:380">
        <a class="ul" href={`mailto:${SITE.email}`}>{SITE.email}</a>
      </p>
    </div>
    <div class="art"><Doodle /></div>
  </section>

  <section class="sec now" id="now" aria-labelledby="now-h">
    <div>
      <h2 class="h2" id="now-h">How I work</h2>
      <p class="note">Where most of my week goes.</p>
    </div>
    <div>
      <p class="thesis">The model is rarely the hard part. Everything around it is.</p>
      <ul class="parts">
        {
          now.map(([h, p]) => (
            <li>
              <h3>{h}</h3>
              <p>{p}</p>
            </li>
          ))
        }
      </ul>
      <p class="soon">
        <span>Coming soon</span>Orca, a timer for the macOS menu bar that you and an AI agent can both run.
      </p>
    </div>
  </section>

  <section class="sec" id="blogs" aria-labelledby="blogs-h">
    <div class="head">
      <h2 class="h2" id="blogs-h">Blogs</h2>
      <p class="note">Notes on building for the web, and the problems I would rather solve once.</p>
    </div>
    <div class="list">
      <ul>
        {
          posts.map((p) => (
            <li>
              <PostCard post={p} wide />
            </li>
          ))
        }
      </ul>
      <a class="all" href="/blogs">Read all {all.length} posts<span aria-hidden="true">→</span></a>
    </div>
  </section>

  <section class="sec" id="experience" aria-labelledby="xp-h">
    <div class="head">
      <h2 class="h2" id="xp-h">Experience</h2>
      <p class="note">The teams I’ve built with, newest first.</p>
    </div>
    <ol class="list tl">
      {
        jobs.map((j, i) => (
          <li class:list={['job', { cur: !j.to }]} style={`--t0:${i / Math.max(1, jobs.length - 1)};--t1:${(i + 1) / Math.max(1, jobs.length - 1)}`}>
            <span class="node" aria-hidden="true" />
            <div class="what">
              <div class="who">
                <span class="tile" style={`padding:${j.pad}px`}>
                  <img src={j.logo.src} alt={`${j.company} logo`} width={j.logo.width} height={j.logo.height} loading="lazy" decoding="async" />
                </span>
                <div>
                  <h3 class="pn">{j.role}</h3>
                  <p class="co">{j.company}</p>
                  <p class="when">
                    <time datetime={j.from[0]}>{j.from[1]}</time>
                    {j.to ? (
                      <>
                        to <time datetime={j.to[0]}>{j.to[1]}</time>
                      </>
                    ) : (
                      <span class="till">to now</span>
                    )}
                  </p>
                </div>
              </div>
              <p class="cs">{j.text}</p>
              {j.work.length > 0 && (
                <ul class="wk">
                  {j.work.map((w) => (
                    <li>{w}</li>
                  ))}
                </ul>
              )}
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="sec" id="projects" aria-labelledby="projects-h">
    <div class="head">
      <h2 class="h2" id="projects-h">Projects</h2>
      <p class="note">Tools I built for my own problems, then released.</p>
    </div>
    <ul class="list">
      {
        work.map((w) => (
          <li>
            <a
              class="proj"
              href={w.href}
              rel="noopener"
              target="_blank"
              aria-label={`${w.name}: ${w.go} (opens in a new tab)`}
              aria-describedby={`pj-${w.id}`}
            >
              <span class="pj">
                <span class="pt">
                  <span class="pn">{w.name}</span>
                  <span class:list={['stat', { on: !w.to }]}>{w.to ? 'Finished' : 'Active'}</span>
                  <span class="pm">
                    {w.kind}, {w.to ? `${w.from} to ${w.to}` : `since ${w.from}`}
                  </span>
                </span>
                <span class="cs" id={`pj-${w.id}`}>
                  {w.summary}
                </span>
                <span class="go">{w.go}</span>
              </span>
              <span class="still" aria-hidden="true">
                <span class="st-in">
                  {w.id === 'tooltip' && (
                    <>
                      <span class="tt" data-tip="Saved">
                        Save changes
                      </span>
                      <code class="tt-code">&lt;button data-tooltip="Saved"&gt;</code>
                    </>
                  )}
                  {w.id === 'diver' && (
                    <span class="dv">
                      <span class="dv-top">
                        <span>rajiv.me</span>
                        <span class="dv-nav">
                          <span>About</span>
                          <span>Blogs</span>
                        </span>
                      </span>
                      <span class="dv-h">Software you don’t have to think about.</span>
                      <span>I’m a software engineer.</span>
                    </span>
                  )}
                  {w.id === 'yt' && (
                    <span class="yt">
                      <span class="yt-total">11:42:37</span>
                      <span class="yt-cap">Total watch time, 64 videos</span>
                      <span class="yt-list">
                        <span>Kepler’s laws of motion</span>
                        <span>18:24</span>
                        <span>Orbits and escape velocity</span>
                        <span>21:10</span>
                        <span>The Hohmann transfer</span>
                        <span>16:52</span>
                      </span>
                    </span>
                  )}
                  {w.id === 'site' && <svg class="mk" viewBox="-2.01 0 30 30" fill="#ff5f1f" set:html={mark}></svg>}
                </span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>

<script>
  // Scroll spy for the header nav: the section crossing the middle of the screen is the active one. Now counts
  // as About, Experience (under Blogs) as Blogs and the footer as Projects, so a jump to the end still lands there.
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-spy]')];
  const foot = document.querySelector('footer');
  const secs = [...['about', 'now', 'blogs', 'experience', 'projects'].map((id) => document.getElementById(id)), foot].filter(
    (s): s is HTMLElement => !!s,
  );
  const spyOf = (el: Element) =>
    el === foot ? 'projects' : el.id === 'now' ? 'about' : el.id === 'experience' ? 'blogs' : el.id;
  const set = (id: string) =>
    links.forEach((a) => {
      if (a.dataset.spy === id) a.setAttribute('aria-current', 'true');
      else a.removeAttribute('aria-current');
    });
  // A click on a nav link moves the underline straight to it and holds it there while the page scrolls, so it doesn't
  // stop at every section on the way. When the scroll ends (or after 2 s) the hold lets go and the underline goes to
  // the section actually in the middle, in case the scroll was cut short.
  let held = false;
  const spy = new IntersectionObserver(
    (entries) => entries.forEach((e) => e.isIntersecting && !held && set(spyOf(e.target))),
    { rootMargin: '-45% 0px -54% 0px' },
  );
  secs.forEach((s) => spy.observe(s));
  let free: () => void = () => {};
  links.forEach((a) =>
    a.addEventListener('click', () => {
      removeEventListener('scrollend', free);
      held = true;
      set(a.dataset.spy!);
      const t = setTimeout(() => free(), 2000);
      free = () => {
        clearTimeout(t);
        removeEventListener('scrollend', free);
        held = false;
        const y = innerHeight * 0.45;
        const s = secs.find((s) => {
          const r = s.getBoundingClientRect();
          return r.top <= y && r.bottom > y;
        });
        if (s) set(spyOf(s));
      };
      addEventListener('scrollend', free, { once: true });
    }),
  );

  // The current job's dot pulses while the job is on screen: `.live` goes on as it comes into view and off once it
  // has left, so off screen the pulse does no work.
  const cur = document.querySelector('.job.cur');
  if (cur)
    new IntersectionObserver(([e]) => cur.classList.toggle('live', e.isIntersecting), { threshold: 0.3 }).observe(cur);
</script>

<style>
  /* Landing: the frame (text left, doodle right) is global.css's `.hero`, shared with the 404. */
  h1 {
    font-weight: 500;
  }
  .name {
    display: block;
    font-size: var(--t-sm);
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--accent);
  }
  /* The headline a step lighter than the rest of the display type: big and quiet, not heavy. */
  .st {
    display: block;
    margin-top: 20px;
    font-size: var(--t-display);
    font-weight: 400;
    line-height: 1.02;
    letter-spacing: -0.03em;
    color: var(--hi);
  }
  /* One short paragraph in --muted, the values phrase in --ink, then the address. */
  .intro {
    max-width: 28em;
    margin-top: 32px;
    font-size: var(--t-sm);
    line-height: 1.55;
    letter-spacing: -0.005em;
    color: var(--muted);
    text-wrap: pretty;
  }
  /* The values phrase reads as plain text until the pointer is on the paragraph. Then the orange flows through it
     left to right, line after line (the gradient spans the phrase as one strip), and ebbs back on leave. */
  .hl {
    background: linear-gradient(90deg, var(--accent) 40%, var(--ink) 60%) 100% 0 / 250% 100% no-repeat;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  @media (prefers-reduced-motion: no-preference) {
    .hl {
      transition: background-position 1100ms var(--ease);
    }
  }
  @media (hover: hover) {
    .intro:hover .hl {
      background-position: 0 0;
    }
  }
  .reach {
    margin-top: 28px;
    font-size: var(--t-xs);
  }
  .sec {
    padding-top: 120px;
  }
  /* Every section below the landing reads top to bottom: the h2 and its note at the margin, then the content under
     them, indented a step (112px at 1440) and capped at 1040px. That indent is the one text edge: every title,
     paragraph and logo in every section starts on it, and nothing indents further (the Experience rail hangs in the
     gutter left of it, like a bullet). Rows that carry a picture or dates put them in one right-hand column,
     `--media` wide, 48px from the text. Body text stops at 36em (about 68 characters). No indent on a phone. */
  .sec > :last-child {
    max-width: 1040px;
    margin-top: 40px;
    margin-left: clamp(0px, 7.8vw, 112px);
  }
  @media (max-width: 720px) {
    .sec > :last-child {
      margin-top: 24px;
      margin-left: 0;
    }
  }
  /* Quiet reveals: each row fades up 12px as it scrolls in, tied to its own position (a CSS view timeline, no
     script), so rows stagger by themselves and a jump from the nav lands with them already shown. Experience entries
     only fade, so the nodes stay on the still rail. Without view timelines, under reduced motion and in print the
     rows are simply there. The timeline and range sit in their own :root rule (the minifier would fold them into the
     shorthand, where animation-timeline is reset-only; DESIGN.md §4). */
  @keyframes row-in {
    from {
      opacity: 0;
      translate: 0 12px;
    }
  }
  @keyframes fade-in {
    from {
      opacity: 0;
    }
  }
  @media screen and (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .list > ul > li,
      ul.list > li,
      .all {
        animation: row-in linear both;
      }
      .job {
        animation: fade-in linear both;
      }
      :root :is(.list > ul > li, ul.list > li, .all, .job) {
        animation-timeline: view();
        animation-range: entry 10% entry 60%;
      }
    }
  }
  /* Now: the thesis, its four parts in two columns on hairlines, then what ships next. */
  .thesis {
    max-width: 22em;
    font-size: var(--t-m);
    font-weight: 400;
    line-height: 1.3;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }
  .parts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 40px;
    margin-top: 48px;
  }
  .parts li {
    padding-top: 16px;
    border-top: 1px solid var(--line);
  }
  h3 {
    font-weight: 500;
    letter-spacing: -0.01em;
  }
  .parts p {
    margin-top: 6px;
    color: var(--muted);
    text-wrap: pretty;
  }
  .soon {
    max-width: 36em;
    margin-top: 32px;
    color: var(--muted);
    text-wrap: pretty;
  }
  .soon span {
    margin-right: 12px;
    color: var(--accent);
  }
  .h2 {
    font-size: var(--t-l);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }
  .note {
    max-width: 36em;
    margin-top: 12px;
    color: var(--muted);
    text-wrap: pretty;
  }
  /* Experience as a timeline that keeps the text edge: each entry is the job (logo tile, role and company, one line
     on the product, the work) on the edge, and its dates in the right-hand column where the covers and stills sit.
     The rail hangs in the gutter left of the edge, one stroke of colour from now into the past: bright --accent at
     the current job, cooling to an ember (the accent faded into the page, so it stays in the orange family) at the oldest, and ending there. Each job
     carries its place on it (--t0 at its node, --t1 at the next, 0 to 1 down the list), so the segments join into one
     gradient however many jobs there are, and each node is a dot filled with the rail's colour where it sits, with a
     soft halo of the same colour (the current job's wider). */
  .tl {
    position: relative;
    --ember: color-mix(in oklab, var(--accent) 58%, var(--bg));
  }
  .job {
    --c0: color-mix(in oklab, var(--accent) calc(100% - var(--t0, 0) * 100%), var(--ember));
    --c1: color-mix(in oklab, var(--accent) calc(100% - var(--t1, 1) * 100%), var(--ember));
  }
  .job:not(:last-child)::before {
    content: "";
    position: absolute;
    left: -35px;
    top: 27px;
    bottom: -27px;
    width: 2px;
    border-radius: 1px;
    background: linear-gradient(var(--c0), var(--c1));
    transform-origin: top;
  }
  /* The rail draws itself down from each node as it scrolls in, on its own view timeline (no script); anywhere the
     row reveal doesn't run, it is simply there. */
  @keyframes rail-in {
    from {
      scale: 1 0;
    }
  }
  @media screen and (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      /* A pseudo-element can't be a view timeline's subject, so the job names its own and the line follows it. */
      .job {
        view-timeline: --job;
      }
      .job:not(:last-child)::before {
        animation: rail-in linear both;
      }
      :root .job:not(:last-child)::before {
        animation-timeline: --job;
        animation-range: entry 40% cover 55%;
      }
    }
  }
  .job {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) var(--media);
    gap: 0 48px;
    padding-bottom: 48px;
  }
  .job:last-child {
    padding-bottom: 8px;
  }
  .what {
    grid-area: 1 / 1;
  }
  /* The dates sit under the company in the markup (read in that order); from 721px they are lifted into the
     right-hand column, level with the top of the entry. */
  .when {
    position: absolute;
    top: 0;
    right: 0;
    width: var(--media);
    padding-top: 2px;
    font-size: var(--t-xs);
    line-height: 1.4;
    color: var(--muted);
  }
  .when time:first-child {
    display: block;
    color: var(--ink);
  }
  .node {
    position: absolute;
    left: -40px;
    top: 21px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--c0);
    box-shadow: 0 0 0 3px color-mix(in oklab, var(--c0) 16%, transparent);
  }
  .cur .node {
    box-shadow: 0 0 0 5px color-mix(in oklab, var(--c0) 20%, transparent);
  }
  /* The current job breathes: a soft ring of the accent swells out of its dot and fades, every 3 s, while the job is
     on screen (the script below sets `.live`), so off screen nothing runs. Only transform and opacity move. The
     drawing's pause button (Doodle.astro, `html.held`) stops it too (WCAG 2.2.2). A past job never pulses. Reduced
     motion: the still halo only. */
  .node::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: var(--c0);
    opacity: 0;
  }
  @keyframes pulse {
    0% {
      opacity: 0.4;
      scale: 1;
    }
    70%,
    100% {
      opacity: 0;
      scale: 2.8;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .cur.live .node::after {
      animation: pulse 3000ms var(--ease) infinite;
    }
    :global(html.held) .cur.live .node::after {
      animation-play-state: paused;
    }
  }
  /* "to now" in the accent: the current job reads as live, in the rail's colour. */
  .till {
    color: var(--accent);
  }
  .who {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .tile {
    display: grid;
    flex: none;
    width: 44px;
    height: 44px;
    border: 1px solid var(--tile-edge);
    border-radius: 11px;
    background: var(--tile);
  }
  .tile img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .job .pn {
    margin-top: 0;
  }
  .co {
    margin-top: 2px;
    color: var(--muted);
  }
  .job .cs {
    max-width: 36em;
    margin-top: 16px;
    color: var(--ink);
  }
  /* The work list's markers hang into the gutter, so its text keeps the edge too. */
  .wk {
    max-width: 36em;
    margin-top: 12px;
    padding-left: 0;
    list-style: disc outside;
    color: var(--muted);
  }
