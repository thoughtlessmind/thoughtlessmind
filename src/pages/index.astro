---
import BaseLayout from '../layouts/BaseLayout.astro';
import Doodle from '../components/Doodle.astro';
import PostCard from '../components/PostCard.astro';
import { SITE } from '../consts';
import { getPosts } from '../lib/writing';

// Each project links to the real thing. The stills are drawn in HTML below (DESIGN.md §5).
const work = [
  {
    id: 'tooltip',
    name: 'css-only-tooltip',
    kind: 'Library',
    year: 2021,
    summary: 'A tooltip library with no JavaScript. Data attributes in, tooltip out.',
    href: 'https://www.npmjs.com/package/css-only-tooltip',
  },
  {
    id: 'diver',
    name: 'Diver',
    kind: 'Chrome extension',
    year: 2023,
    summary: 'Outlines every element on a page, so you can see the layout you are debugging.',
    href: 'https://chrome.google.com/webstore/detail/diver/onfnfdmnccoaknhjinebmlncejnofhoc',
  },
  {
    id: 'yt',
    name: 'YouTube Playlist Info',
    kind: 'Web app',
    year: 2020,
    summary: 'Paste a playlist link and see how long it really takes to watch.',
    href: 'https://youtube-playlist-info.netlify.app',
  },
  {
    id: 'site',
    name: 'rajiv.me',
    kind: 'This site',
    year: 2026,
    summary: 'Static pages, one hand-built intro, and no work at all once it lands.',
    href: `${SITE.socials.github}/thoughtlessmind`,
  },
];
// The four newest posts; /writing has the rest.
const posts = (await getPosts()).slice(0, 4);
// Lately's rows, under its lead: what the work is made of now (DESIGN.md §5).
const lately = [
  ['Tools for agents', 'MCP servers that give a model typed access to a product’s data and actions, with errors it can recover from.'],
  ['In production', 'Chat, extraction and matching features that real people use, each with a budget for latency and cost, and a fallback.'],
  ['Evals', 'Checks that run on every prompt and model change, so a regression fails a test before it reaches a user.'],
  ['Day to day', 'Coding agents as part of the team, with skills, hooks and review loops that keep every diff small and verified.'],
  ['Coming soon', 'Orca, a macOS menu bar timer that a person and an agent drive together over MCP.'],
];
const mark =
  '<path d="M8.66 5 17.32 10v10l-8.66 5L0 20V10z" fill-opacity=".45"></path><path d="M17.32 10l8.66 5v10l-8.66 5-8.66-5V15z" fill-opacity=".65"></path><path d="M17.32 0l8.66 5v10l-8.66 5-8.66-5V5z" fill-opacity=".8"></path>';
---

<BaseLayout intro>
  <section class="hero" id="about" aria-labelledby="h1">
    <div class="art" aria-hidden="true"><Doodle /></div>
    <div class="hero-text">
      <h1 id="h1">
        <span class="name rise" style="--d:120">{SITE.name}<span class="sr-only">,</span></span>
        <span class="st rise" style="--d:190">Software you don’t <br />have to think about.</span>
      </h1>
      <dl class="facts rows">
        <div class="rise" style="--d:300"><dt>Based in</dt><dd>{SITE.location}</dd></div>
        <div class="rise" style="--d:340">
          <dt>Builds</dt><dd>Web and native apps, backends and infrastructure, since {SITE.since}</dd>
        </div>
        <div class="rise" style="--d:380"><dt>Lately</dt><dd>Putting language models to work inside real products</dd></div>
        <div class="rise" style="--d:420">
          <dt>Cares about</dt><dd>Software that’s fast to load, clear to use and boring to run</dd>
        </div>
        <div class="rise" style="--d:460"><dt>Off screen</dt><dd>Astronomy, rockets, physics and sport</dd></div>
        <div class="rise" style="--d:500">
          <dt>Elsewhere</dt>
          <dd>
            <a class="ul" href={SITE.socials.github} rel="me">GitHub</a>, <a class="ul" href={SITE.socials.linkedin} rel="me"
              >LinkedIn</a
            >, <a class="ul" href={SITE.socials.x} rel="me">X</a>, <a class="ul" href={`mailto:${SITE.email}`}>email</a>
          </dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="sec lately" id="lately" aria-labelledby="lately-h">
    <div class="ly-head">
      <h2 class="h2" id="lately-h">Lately</h2>
      <p class="lead">
        Most of my week now goes to putting language models to work inside real products. The model is rarely the hard
        part. Everything around it is: the tools it can call, the data it may see, what happens when it is slow or wrong,
        and how you know a change made it better rather than just different.
      </p>
    </div>
    <dl class="rows">
      {
        lately.map(([dt, dd]) => (
          <div>
            <dt>{dt}</dt>
            <dd>{dd}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section class="sec" id="writing" aria-labelledby="writing-h">
    <div class="head">
      <h2 class="h2" id="writing-h">Writing</h2>
      <p class="note">Notes on models, the web and problems worth writing down.</p>
    </div>
    <ul class="cards">
      {
        posts.map((p) => (
          <li>
            <PostCard post={p} />
          </li>
        ))
      }
    </ul>
    <a class="ul all" href="/writing">All writing</a>
  </section>

  <section class="sec" id="projects" aria-labelledby="projects-h">
    <div class="head">
      <h2 class="h2" id="projects-h">Projects</h2>
      <p class="note">Tools I built for my own problems, then released.</p>
    </div>
    <ul class="cards">
      {
        work.map((w) => (
          <li>
            <a class="card" href={w.href} rel="noopener" target="_blank">
              <span class="still" aria-hidden="true">
                <span class="st-in">
                  {w.id === 'tooltip' && (
                    <>
                      <span class="tt" data-tip="Saved">
                        Save changes
                      </span>
                      <code class="tt-code">&lt;button data-tooltip="Saved"&gt;</code>
                    </>
                  )}
                  {w.id === 'diver' && (
                    <span class="dv">
                      <span class="dv-top">
                        <span>rajiv.me</span>
                        <span class="dv-nav">
                          <span>Work</span>
                          <span>Writing</span>
                        </span>
                      </span>
                      <span class="dv-h">Software you don’t have to think about.</span>
                      <span>A software engineer in New Delhi.</span>
                    </span>
                  )}
                  {w.id === 'yt' && (
                    <span class="yt">
                      <span class="yt-total">11:42:37</span>
                      <span class="yt-cap">Total watch time, 64 videos</span>
                      <span class="yt-list">
                        <span>Kepler’s laws of motion</span>
                        <span>18:24</span>
                        <span>Orbits and escape velocity</span>
                        <span>21:10</span>
                        <span>The Hohmann transfer</span>
                        <span>16:52</span>
                      </span>
                    </span>
                  )}
                  {w.id === 'site' && <svg class="mk" viewBox="-2.01 0 30 30" fill="#ff5f1f" set:html={mark}></svg>}
                </span>
              </span>
              <span class="cn">
                {w.name}
                <span class="cy">
                  {w.kind}, {w.year}
                </span>
              </span>
              <span class="cs">{w.summary}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>

<script>
  // Scroll spy for the header nav: the section crossing the middle of the screen is the active one. Lately counts as
  // About and the footer as Projects, so a jump to the end still lands there.
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-spy]')];
  const foot = document.querySelector('footer');
  const spy = new IntersectionObserver(
    (entries) =>
      entries.forEach((e) => {
        if (!e.isIntersecting) return;
        const id = e.target === foot ? 'projects' : e.target.id === 'lately' ? 'about' : e.target.id;
        links.forEach((a) => {
          const on = a.dataset.spy === id;
          a.classList.toggle('on', on);
          if (on) a.setAttribute('aria-current', 'true');
          else a.removeAttribute('aria-current');
        });
      }),
    { rootMargin: '-45% 0px -54% 0px' },
  );
  ['about', 'lately', 'writing', 'projects'].forEach((id) => {
    const s = document.getElementById(id);
    if (s) spy.observe(s);
  });
  if (foot) spy.observe(foot);
</script>

<style>
  /* Landing: about me on the left, the doodle on the right 48%. It runs to the right edge of the screen and clips
     the doodle there. */
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    min-height: clamp(640px, 100vh, 960px);
    margin-right: calc(-1 * var(--gut-r));
    padding-block: 112px 56px;
    overflow-x: clip;
  }
  .hero-text {
    position: relative;
    z-index: 1;
    width: min(760px, 52vw);
  }
  h1 {
    font-weight: 500;
  }
  .name {
    display: block;
    font-size: var(--t-m);
    line-height: 1.2;
    letter-spacing: -0.015em;
    color: var(--accent);
  }
  .st {
    display: block;
    margin-top: 16px;
    font-size: var(--t-xl);
    line-height: 0.98;
    letter-spacing: -0.045em;
  }
  .facts {
    max-width: 580px;
    margin-top: 56px;
  }
  /* Label and value rows on hairlines: the landing's facts and Lately's. */
  .rows > div {
    display: grid;
    grid-template-columns: 136px minmax(0, 1fr);
    column-gap: 24px;
    align-items: baseline;
    padding-block: 12px;
    border-top: 1px solid var(--line);
  }
  dt {
    font-size: var(--t-xs);
    color: var(--muted);
  }
  dd {
    text-wrap: pretty;
  }
  .art {
    position: absolute;
    inset: 0 0 0 auto;
    width: 48vw;
    padding: 96px 56px 40px 0;
    pointer-events: none;
  }

  .sec {
    padding-top: 136px;
  }
  /* Lately: the h2 and the lead in the first column, the rows from the axis, so they line up with the header nav. */
  .lately {
    display: grid;
    grid-template-columns: var(--cols);
    align-items: start;
  }
  .ly-head {
    padding-right: clamp(32px, 4.4vw, 72px);
  }
  .lead {
    max-width: 34em;
    margin-top: 24px;
    font-size: var(--t-sm);
    line-height: 1.4;
    letter-spacing: -0.01em;
    text-wrap: pretty;
  }
  .lately .rows {
    margin-top: 10px;
  }
  @media (max-width: 999px) {
    .lately {
      display: block;
    }
    .lately .rows {
      margin-top: 40px;
    }
  }
  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px 32px;
  }
  .h2 {
    font-size: var(--t-l);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }
  .note {
    color: var(--muted);
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 56px 40px;
    margin-top: 44px;
  }
  /* Project cards (post cards are PostCard's): the still, name with kind and year, then the summary. */
  .card {
    display: block;
    transition: color 200ms var(--ease);
  }
  .card:hover {
    color: var(--hi);
  }
  .still {
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--panel);
  }
  .cn {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    margin-top: 18px;
    font-size: var(--t-sm);
    font-weight: 500;
    letter-spacing: -0.015em;
  }
  .cy {
    flex: none;
    font-size: var(--t-xs);
    font-weight: 400;
    letter-spacing: 0;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .cs {
    display: block;
    margin-top: 4px;
    color: var(--muted);
  }

  /* Stills: each project drawn in HTML, a small illustration set at its own sizes and scaled up 1.35 where the
     card is wide enough. */
  .still {
    container-type: inline-size;
  }
  .st-in {
    display: grid;
    justify-items: center;
    scale: 1.35;
    font-size: 14px;
    line-height: 1.4;
  }
  @container (max-width: 420px) {
    .st-in {
      scale: 1;
    }
  }
  /* css-only-tooltip, built the way the library builds it: a data attribute and two pseudo-elements. */
  .tt {
    position: relative;
    margin-top: 30px;
    padding: 9px 14px;
    border-radius: 6px;
    background: var(--bg);
    font-weight: 500;
  }
  .tt::after {
    content: attr(data-tip);
    position: absolute;
    left: 50%;
    bottom: calc(100% + 10px);
    translate: -50% 0;
    padding: 4px 9px;
    border-radius: 5px;
    background: var(--ink);
    color: var(--bg);
    font-size: 13px;
    white-space: nowrap;
  }
  .tt::before {
    content: '';
    position: absolute;
    left: 50%;
    bottom: calc(100% + 5px);
    translate: -50% 0;
    border: 5px solid transparent;
    border-bottom: 0;
    border-top-color: var(--ink);
  }
  .tt-code {
    margin-top: 22px;
    font-family: var(--mono);
    font-size: 12px;
    color: var(--muted);
  }
  /* Diver: every element outlined. */
  .dv {
    display: grid;
    gap: 7px;
    width: 210px;
    padding: 10px;
    background: var(--bg);
    font-size: 11px;
    line-height: 1.3;
  }
  .dv,
  .dv * {
    outline: 1px solid var(--accent);
  }
  .dv-top {
    display: flex;
    justify-content: space-between;
  }
  .dv-nav {
    display: flex;
    gap: 6px;
  }
  .dv-h {
    margin-top: 8px;
    font-size: 17px;
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.03em;
  }
  /* YouTube Playlist Info: the total, then the videos that add up to it. */
  .yt {
    display: grid;
    width: 210px;
    font-size: 12px;
  }
  .yt-total {
    font-size: 26px;
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
  }
  .yt-cap,
  .yt-list > :nth-child(even) {
    color: var(--muted);
  }
  .yt-list {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 5px 12px;
    margin-top: 12px;
    font-variant-numeric: tabular-nums;
  }
  .mk {
    width: 72px;
    height: 72px;
    fill: var(--logo);
  }
  .all {
    display: inline-block;
    margin-top: 40px;
  }

  /* Phone: the doodle in a band under the header, the text under it; Lately's rows stack under its h2. */
  @media (max-width: 720px) {
    .hero {
      display: block;
      min-height: 0;
      margin-right: 0;
      padding-block: 300px 48px;
    }
    .hero-text {
      width: auto;
    }
    .art {
      inset: 76px 0 auto;
      width: auto;
      height: 208px;
      padding: 0;
    }
    .art :global(.doodle) {
      --k: 1.8;
    }
    .st {
      margin-top: 12px;
      line-height: 1;
      letter-spacing: -0.04em;
      text-wrap: balance;
    }
    .st br {
      display: none;
    }
    .facts {
      margin-top: 36px;
    }
    .rows > div {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 2px;
      padding-block: 10px;
    }
    .sec {
      padding-top: 104px;
    }
    .lead {
      margin-top: 20px;
    }
    .lately .rows {
      margin-top: 32px;
    }
    .cards {
      grid-template-columns: minmax(0, 1fr);
      gap: 44px;
      margin-top: 32px;
    }
  }
</style>
