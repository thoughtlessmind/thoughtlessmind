---
import BaseLayout from '../layouts/BaseLayout.astro';
import Avatar from '../components/Avatar.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Timeline from '../components/Timeline.astro';
import { SITE } from '../consts';
import { person } from '../lib/person';

const dek = "Web engineer in New Delhi. I've built for the web since 2019, mostly in React and TypeScript.";
const description =
  'Rajiv Kumar (thoughtlessmind), web engineer in New Delhi since 2019: React, TypeScript, 98 Stack Overflow answers and the css-only-tooltip library.';
// Bump when the facts on this page change; deliberately not the build date.
const dateModified = '2026-10-07';
const { '@context': context, ...entity } = person();
const profile = { '@context': context, '@type': 'ProfilePage', dateModified, mainEntity: entity };
// Three clusters instead of a row-per-item table.
const stack = [
  { group: 'Language and UI', items: ['TypeScript', 'React', 'Next.js', 'Astro'] },
  { group: 'Styling and state', items: ['Tailwind CSS', 'Material UI', 'Redux'] },
  { group: 'Build and platform', items: ['Vite', 'Webpack', 'Node', 'Chrome extensions'] },
];
---

<BaseLayout title="About" description={description} jsonLd={profile}>
  <header class="container-site page-head about-head">
    <Avatar size={176} />
    <div>
      <h1 class="page-title flicker">About</h1>
      <p class="page-head__dek">{dek}</p>
      <p class="about-head__actions">
        <a href={`mailto:${SITE.email}`} class="btn btn-primary"><span data-scramble="hover">Email me</span></a>
      </p>
    </div>
  </header>

  <div class="container-site about">
    <div class="about__prose" data-reveal-group>
      <p class="reveal">
        I started building for the web in {SITE.since} and haven't stopped. Most of my work is React and TypeScript in
        production: design systems, dashboards, and the performance work that keeps them fast.
      </p>
      <p class="reveal">
        I like tools that do one job completely. css-only-tooltip is a tooltip library with no JavaScript at all. Diver
        is a Chrome extension that outlines every element on a page, so you can see the layout in one click. YouTube
        Playlist Info tells you how long a playlist takes before you start it.
      </p>
      <p class="reveal">
        I also answer frontend questions on Stack Overflow: 98 answers and 3.8k reputation so far, mostly on Material UI
        and React. Outside work I read about rockets and physics, and watch whatever sport is on.
      </p>
    </div>

    <section class="about__block" aria-labelledby="experience-title" data-reveal-group>
      <SectionHeading title="Experience" id="experience-title" class="reveal" />
      <div class="reveal about__measure"><Timeline /></div>
    </section>

    <section class="about__block" aria-labelledby="stack-title" data-reveal-group>
      <SectionHeading title="Stack" id="stack-title" class="reveal" />
      <dl class="stack reveal">
        {
          stack.map((s) => (
            <div class="stack__group">
              <dt>{s.group}</dt>
              <dd>
                <ul class="stack__items">
                  {s.items.map((i) => (
                    <li class="tag">{i}</li>
                  ))}
                </ul>
              </dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section class="hud now" aria-labelledby="now-title" data-reveal-group>
      <h2 id="now-title" class="now__title reveal">Now</h2>
      <p class="reveal">Writing about how this site is built, one post at a time. Reading about orbital mechanics.</p>
    </section>
  </div>
</BaseLayout>

<style>
  .about-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem;
    align-items: start;
  }
  .about-head__actions {
    margin-top: 2rem;
  }
  @media (min-width: 720px) {
    .about-head {
      grid-template-columns: auto minmax(0, 1fr);
      gap: clamp(2rem, 5vw, 4rem);
    }
  }

  .about {
    padding-bottom: var(--spacing-section);
  }
  .about__prose,
  .about__measure {
    max-width: var(--container-measure);
  }
  .about__prose > p + p {
    margin-top: 1.25em;
  }
  .about__block {
    margin-top: calc(var(--spacing-section) * 0.6);
  }

  /* Stack: three clusters, name left and tags right from 720px; one soft divider between clusters. */
  .stack {
    max-width: 52rem;
    margin: 0;
  }
  .stack__group {
    display: grid;
    gap: 0.75rem;
  }
  .stack__group + .stack__group {
    margin-top: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }
  .stack__group dt {
    font-weight: 600;
  }
  .stack__group dd {
    margin: 0;
  }
  .stack__items {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 720px) {
    .stack__group {
      grid-template-columns: 14rem minmax(0, 1fr);
      align-items: baseline;
      gap: 2rem;
    }
  }

  /* Now: the one framed block on the page. */
  .now {
    max-width: var(--container-measure);
    margin-top: calc(var(--spacing-section) * 0.6);
    padding: 1.5rem;
    background: var(--bg-elevated);
  }
  .now__title {
    font-size: var(--text-h3);
    line-height: var(--text-h3--line-height);
    letter-spacing: -0.01em;
  }
  .now p {
    margin-top: 0.5rem;
    color: var(--text-muted);
  }
</style>
