---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import SiteCaseStudy from '../components/SiteCaseStudy.astro';
import ProjectCard from '../components/ProjectCard.astro';

const byOrder = (a: { data: { order: number } }, b: { data: { order: number } }) => a.data.order - b.data.order;
const all = await getCollection('projects');
const featured = all.filter((p) => p.data.featured && !p.data.archived).sort(byOrder);
// Everything not featured above, live projects first, archived last. Each project appears once on the page.
const more = [
  ...all.filter((p) => !p.data.featured && !p.data.archived).sort(byOrder),
  ...all.filter((p) => p.data.archived).sort(byOrder),
];
const dek = 'Small tools for everyday frontend annoyances, and the rebuild of this site.';
const description =
  "Projects by Rajiv Kumar: css-only-tooltip, the Diver Chrome extension, YouTube Playlist Info, and this site's Astro rebuild.";
---

<BaseLayout title="Work" description={description}>
  <header class="container-site page-head">
    <h1 class="page-title flicker">Work</h1>
    <p class="page-head__dek">{dek}</p>
  </header>

  <div class="container-site work__featured" data-reveal-group>
    <div class="reveal"><SiteCaseStudy level="h2" /></div>
    <ul class="work__modules">
      {featured.map((p) => <ProjectCard project={p} level="h2" long class="reveal" />)}
    </ul>
  </div>

  <section class="container-site section" aria-labelledby="index-title" data-reveal-group>
    <SectionHeading title="More projects" id="index-title" class="reveal" />
    <ul class="more">
      {
        more.map((p) => {
          const { title, summary, year, stack, repo, live, archived } = p.data;
          return (
            <li class:list={['more__item reveal', { 'is-archived': archived }]}>
              <p class="label more__year">
                {year}
                {archived && <span class="tag">archived</span>}
              </p>
              <div>
                <h3 class="more__title">{title}</h3>
                <p class="more__summary">{summary}</p>
                <p class="more__stack">{stack.join(' / ')}</p>
              </div>
              <p class="label more__links">
                {repo && (
                  <a href={repo} class="link tap" rel="noopener" target="_blank">
                    Repo<span class="sr-only"> of {title}</span> <span aria-hidden="true">↗</span>
                  </a>
                )}
                {live && (
                  <a href={live} class="link tap" rel="noopener" target="_blank">
                    Live<span class="sr-only"> {title}</span> <span aria-hidden="true">↗</span>
                  </a>
                )}
              </p>
            </li>
          );
        })
      }
    </ul>
  </section>
</BaseLayout>

<style>
  .work__modules {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 720px) {
    .work__modules {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* More projects: a plain list, no frames or row rules. From 900px each entry is one row: year | name and
     summary | links. Archived entries are dimmed by colour, not opacity, so they keep AA contrast. */
  .more {
    display: grid;
    gap: 2.5rem;
    max-width: 60rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .more__item {
    display: grid;
    gap: 0.5rem;
  }
  @media (min-width: 900px) {
    .more__item {
      grid-template-columns: 12ch minmax(0, 1fr) 10rem;
      align-items: baseline;
      gap: 2rem;
    }
  }
  /* Below 900px the year follows the description (no label above the title); from 900px it is the first column. */
  .more__year {
    order: 1;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 0;
  }
  .more__links {
    order: 2;
  }
  @media (min-width: 900px) {
    .more__year,
    .more__links {
      order: 0;
    }
  }
  .more__title {
    font-size: var(--text-h3);
    line-height: var(--text-h3--line-height);
    letter-spacing: -0.01em;
  }
  .more__summary {
    margin-top: 0.375rem;
    font-size: var(--text-small);
    color: var(--text-muted);
  }
  .more__stack {
    margin-top: 0.5rem;
    font-family: var(--font-ui);
    font-size: var(--text-caption);
    color: var(--text-subtle);
  }
  .more__links {
    display: flex;
    gap: 0 1.5rem;
  }
  @media (min-width: 900px) {
    .more__links {
      justify-content: flex-end;
    }
  }
  .more__links a {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
  }
  .is-archived :is(.more__title, .more__summary) {
    color: var(--text-subtle);
  }
</style>
