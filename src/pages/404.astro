---
import BaseLayout from '../layouts/BaseLayout.astro';
import Doodle from '../components/Doodle.astro';
import { SITE } from '../consts';
---

<BaseLayout title={`Page not found, ${SITE.name}`} description="There is nothing at this address.">
  {/* The landing's frame and its drawing (global.css `.hero`): the telescope, still looking. */}
  <section class="hero" aria-labelledby="h1">
    <div class="art" aria-hidden="true"><Doodle /></div>
    <div class="hero-text">
      <h1 id="h1">Page not found.</h1>
      <p>
        There is nothing at this address. The link may be old, or the address mistyped. The telescope has not found it
        either.
      </p>
      <ul>
        <li><a class="ul hit" href="/">Back to the home page</a></li>
        <li><a class="ul hit" href="/blogs">All blogs</a></li>
      </ul>
    </div>
  </section>
  <meta slot="head" name="robots" content="noindex" />
</BaseLayout>

<style>
  h1 {
    font-size: var(--t-xl);
    font-weight: 500;
    line-height: 0.98;
    letter-spacing: -0.045em;
  }
  p {
    max-width: 30em;
    margin-top: 24px;
    font-size: var(--t-sm);
    color: var(--muted);
    text-wrap: pretty;
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 24px 28px;
    margin-top: 32px;
  }
  @media (max-width: 720px) {
    h1 {
      line-height: 1;
      letter-spacing: -0.04em;
    }
  }
</style>
