---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../consts';
---

<BaseLayout title={`Page not found · ${SITE.name}`} description="There is nothing at this address.">
  <section aria-labelledby="h1">
    <h1 id="h1">Page not found.</h1>
    <p>
      There is nothing at this address. <a class="ul" href="/">Back to the home page</a>.
    </p>
  </section>
</BaseLayout>

<style>
  section {
    display: grid;
    align-content: center;
    gap: 20px;
    min-height: max(100svh, 560px);
    padding-block: 120px 56px;
  }
  h1 {
    font-size: var(--t-xl);
    font-weight: 500;
    line-height: 0.98;
    letter-spacing: -0.045em;
  }
</style>
