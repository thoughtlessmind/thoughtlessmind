---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../consts';
---

<BaseLayout title={`Page not found, ${SITE.name}`} description="There is nothing at this address.">
  <section aria-labelledby="h1">
    <h1 id="h1">Page not found.</h1>
    <p>There is nothing at this address. The link may be old, or the address mistyped.</p>
    <ul>
      <li><a class="ul" href="/">Back to the home page</a></li>
      <li><a class="ul" href="/writing">All writing</a></li>
    </ul>
  </section>
</BaseLayout>

<style>
  /* Clear of the fixed header; the footer follows. */
  section {
    padding-top: calc(var(--head-h) + clamp(64px, 14vh, 160px));
  }
  h1 {
    font-size: var(--t-xl);
    font-weight: 500;
    line-height: 0.98;
    letter-spacing: -0.045em;
  }
  p {
    max-width: 30em;
    margin-top: 24px;
    font-size: var(--t-sm);
    color: var(--muted);
    text-wrap: pretty;
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 28px;
    margin-top: 32px;
  }
  @media (max-width: 720px) {
    section {
      padding-top: calc(var(--head-h) + 48px);
    }
    h1 {
      line-height: 1;
      letter-spacing: -0.04em;
    }
  }
</style>
