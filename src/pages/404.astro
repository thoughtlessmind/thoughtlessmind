---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../consts';
---

<BaseLayout title={`Page not found · ${SITE.name}`} description="There is nothing at this address.">
  <section class="hero" aria-labelledby="h1">
    <h1 id="h1"><span class="line">Page not found.</span></h1>
    <p class="sub">
      There is nothing at this address. <a class="text-ink underline underline-offset-4" href="/">Back to the home page</a>.
    </p>
  </section>
</BaseLayout>
