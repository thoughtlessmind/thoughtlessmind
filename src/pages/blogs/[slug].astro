---
import { render } from 'astro:content';
// Phosphor regular, inlined at build time: no runtime icon code.
import arrowLeft from '@phosphor-icons/core/assets/regular/arrow-left.svg?raw';
import copyIcon from '@phosphor-icons/core/assets/regular/copy.svg?raw';
import checkIcon from '@phosphor-icons/core/assets/regular/check.svg?raw';
import mdIcon from '@phosphor-icons/core/assets/regular/markdown-logo.svg?raw';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { SITE } from '../../consts';
import { cover, day, getPosts, iso, minutes, type Post } from '../../lib/blogs';
import '../../styles/prose.css';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post, more: posts.filter((p) => p.id !== post.id).slice(0, 3), total: posts.length },
  }));
}

interface Props {
  post: Post;
  more: Post[];
  total: number;
}
const { post, more, total } = Astro.props;
const { title, description, date, updated, canonical } = post.data;
const { Content, headings } = await render(post);
const toc = headings.filter((h) => h.depth === 2);
const art = cover(post.id);
const read = `${minutes(post.body)} min read`;
const md = `/blogs/${post.id}.md`;
const inner = (svg: string) => svg.replace(/^<svg[^>]*>|<\/svg>$/g, '');
const arrow = inner(arrowLeft);
// The post, for search engines and agents (schema.org).
const url = `${SITE.url}/blogs/${post.id}`;
const article = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: iso(date),
  dateModified: iso(updated ?? date),
  author: { '@type': 'Person', name: SITE.name, url: SITE.url },
  image: `${SITE.url}/og.png`,
  mainEntityOfPage: url,
};
---

<BaseLayout title={`${title}, Rajiv Kumar`} description={description} current="blogs" progress type="article" jsonLd={article}>
  <meta slot="head" property="article:published_time" content={date.toISOString()} />
  {updated && <meta slot="head" property="article:modified_time" content={updated.toISOString()} />}
  {/* From 1200px a sticky rail on the left holds Back, the date and reading time, the contents and the Markdown
      controls, and the article sits beside it. Under that Back and the meta stack over the title, and the contents and
      Markdown controls follow the article (no contents on a phone). */}
  <div class="post">
    <aside class="side" aria-label="About this post">
      <div class="lead">
        <a class="back hit" href="/blogs">
          <svg viewBox="0 0 256 256" fill="currentColor" aria-hidden="true" focusable="false" set:html={arrow} />Blogs
        </a>
        <p class="meta">
          <time datetime={iso(date)}>{day(date)}</time>
          <span>{read}</span>
          {updated && <span>Updated <time datetime={iso(updated)}>{day(updated)}</time></span>}
        </p>
      </div>
      {
        toc.length > 1 && (
          <nav class="toc" aria-labelledby="toc-side">
            <p id="toc-side">On this page</p>
            <ol>
              {toc.map((h) => (
                <li>
                  <a href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
            </ol>
          </nav>
        )
      }
      <div class="tools">
        <button class="copy" type="button" data-copy={md}>
          <svg class="i i-copy" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true" focusable="false" set:html={inner(copyIcon)} />
          <svg class="i i-done" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true" focusable="false" set:html={inner(checkIcon)} />
          <span aria-live="polite">Copy as Markdown</span>
        </button>
        <a class="md" href={md}>
          <svg class="i" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true" focusable="false" set:html={inner(mdIcon)} />
          <span class="ul">View as Markdown</span>
        </a>
      </div>
    </aside>

    <article class="body">
      <h1 style={`view-transition-name: title-${post.id}`}>{title}</h1>
      <p class="dek">{description}</p>
      {art && <div class="cover" style={`view-transition-name: cover-${post.id}`} aria-hidden="true" set:html={art} />}
      <div class="prose"><Content /></div>
      {
        canonical && (
          <p class="canon">
            First published on <a class="ul" href={canonical}>{new URL(canonical).hostname.replace(/^www\./, '')}</a>.
          </p>
        )
      }
      {/* Who wrote it, for a reader who landed here from a search and has not seen the home page. */}
      <p class="by">
        Written by <a class="ul" href="/">{SITE.name}</a>, a software engineer in New Delhi. If something here is wrong
        or unclear, write to me at <a class="ul" href={`mailto:${SITE.email}`}>{SITE.email}</a>.
      </p>
      <div class="end">
        {
          toc.length > 1 && (
            <nav class="toc" aria-labelledby="toc-end">
              <p id="toc-end">On this page</p>
              <ol>
                {toc.map((h) => (
                  <li>
                    <a href={`#${h.slug}`}>{h.text}</a>
                  </li>
                ))}
              </ol>
            </nav>
          )
        }
        <div class="tools">
          <button class="copy hit" type="button" data-copy={md}>
            <svg class="i i-copy" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true" focusable="false" set:html={inner(copyIcon)} />
            <svg class="i i-done" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true" focusable="false" set:html={inner(checkIcon)} />
            <span aria-live="polite">Copy as Markdown</span>
          </button>
          <a class="md hit" href={md}>
            <svg class="i" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true" focusable="false" set:html={inner(mdIcon)} />
            <span class="ul">View as Markdown</span>
          </a>
        </div>
      </div>
    </article>
  </div>

  {
    more.length > 0 && (
      <section class="more" aria-labelledby="more-h">
        <div>
          <h2 id="more-h">More blogs</h2>
          <p class="note">Notes on building for the web, and the problems I would rather solve once.</p>
        </div>
        <div class="list">
          <ul>
            {more.map((p) => (
              <li>
                <PostCard post={p} wide />
              </li>
            ))}
          </ul>
          <a class="all" href="/blogs">Read all {total} posts<span aria-hidden="true">→</span></a>
        </div>
      </section>
    )
  }
</BaseLayout>

<script>
  // Contents scroll spy: the active heading is the last one above 30% of the viewport. The observer's root runs from
  // far above the page down to that line, so a heading flips exactly when it crosses it, however far a jump goes,
  // and a still page does no work.
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.toc a')];
  const heads = [...new Set(links.map((a) => decodeURIComponent(a.hash.slice(1))))]
    .map((id) => document.getElementById(id))
    .filter((h) => h !== null);
  const spy = () => {
    let on = '';
    for (const h of heads) if (h.getBoundingClientRect().top < innerHeight * 0.3) on = h.id;
    for (const a of links) {
      if (on && decodeURIComponent(a.hash.slice(1)) === on) a.setAttribute('aria-current', 'true');
      else a.removeAttribute('aria-current');
    }
  };
  if (heads.length) {
    const io = new IntersectionObserver(spy, { rootMargin: '100000px 0px -70% 0px' });
    heads.forEach((h) => io.observe(h));
  }

  // Copy as Markdown: fetch the post's .md and put it on the clipboard. Safari only allows a clipboard write inside
  // the click itself, so where it can, the fetch goes in as a pending ClipboardItem rather than being awaited first.
  for (const btn of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
    const label = btn.querySelector('span')!;
    let reset = 0;
    btn.addEventListener('click', async () => {
      const text = () => fetch(btn.dataset.copy!).then((r) => (r.ok ? r.text() : Promise.reject(r.status)));
      try {
        if ('ClipboardItem' in window) {
          const blob = text().then((s) => new Blob([s], { type: 'text/plain' }));
          await navigator.clipboard.write([new ClipboardItem({ 'text/plain': blob })]);
        } else {
          await navigator.clipboard.writeText(await text());
        }
        label.textContent = 'Copied';
        btn.classList.add('done');
      } catch {
        label.textContent = 'Copy failed';
      }
      clearTimeout(reset);
      reset = window.setTimeout(() => {
        label.textContent = 'Copy as Markdown';
        btn.classList.remove('done');
      }, 2000);
    });
  }
</script>

<style>
  .post {
    padding-top: calc(var(--head-h) + 72px);
  }
  /* The article keeps to one measure (44em, 20% wider than the old 37em), so title, dek, cover, code and prose share
     a right edge. Under 1200px the rail is just Back and the meta, stacked over the title on the same measure. */
  .body,
  .side {
    max-width: 44em;
    margin-inline: auto;
  }
  .side :is(.toc, .tools) {
    display: none;
  }
  .lead {
    display: grid;
    justify-items: start;
    gap: 20px;
    margin-bottom: 32px;
  }
  /* From 1200px: the article centred in the middle track, the rail (220px) at the start of the left one, under the logo, its
     top level with the title. The rail sticks under the header: Back, the meta, the contents and the Markdown
     controls. Near 1200px the article gives up its centre before the rail gets narrower. */
  @media (min-width: 1200px) {
    .post {
      display: grid;
      grid-template-columns: minmax(220px, 1fr) minmax(0, 44em) minmax(0, 1fr);
      column-gap: 64px;
    }
    .body,
    .side {
      margin-inline: 0;
    }
    .body {
      grid-column: 2;
    }
    .side {
      grid-column: 1;
      grid-row: 1;
      width: 220px;
      position: sticky;
      top: calc(var(--head-h) + 40px);
      align-self: start;
    }
    .side :is(.toc, .tools) {
      display: revert;
    }
    .side .tools {
      display: flex;
    }
    .lead {
      gap: 28px;
      margin-bottom: 40px;
    }
  }
  .back {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: var(--t-xs);
    transition: color 200ms var(--ease);
  }
  /* Back, the contents, Copy and the Markdown link turn orange on hover or keyboard focus, like every link. */
  @media (hover: hover) {
    .back:hover,
    .toc a:hover,
    .copy:hover,
    .md:hover {
      color: var(--accent);
    }
  }
  .back:focus-visible,
  .toc a:focus-visible,
  .copy:focus-visible,
  .md:focus-visible,
  .back:active,
  .toc a:active,
  .copy:active,
  .md:active {
    color: var(--accent);
  }
  .back svg {
    width: 16px;
    height: 16px;
  }
  .meta {
    display: grid;
    gap: 2px;
    font-size: var(--t-xs);
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  /* Contents: the active heading is --ink with the nav's 6px accent dot before it. */
  .toc {
    margin-top: 40px;
    font-size: var(--t-xs);
  }
  .toc p {
    color: var(--muted);
  }
  .toc ol {
    display: grid;
    gap: 6px;
    margin-top: 12px;
  }
  .toc a {
    display: grid;
    grid-template-columns: 6px minmax(0, 1fr);
    column-gap: 12px;
    color: var(--muted);
    text-wrap: pretty;
    transition: color 200ms var(--ease);
  }
  .toc a::before {
    content: '';
    width: 6px;
    height: 6px;
    margin-top: calc(0.75em - 3px);
    border-radius: 50%;
    transition: background-color 200ms var(--ease);
  }
  .toc a[aria-current] {
    color: var(--ink);
  }
  .toc a[aria-current]::before {
    background: var(--accent);
  }

  .tools {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
    margin-top: 40px;
    font-size: var(--t-xs);
  }
  .copy {
    appearance: none;
    padding: 0;
    border: 0;
    background: none;
    color: var(--ink);
    font: inherit;
    cursor: pointer;
    transition: color 200ms var(--ease);
  }
  /* Both Markdown controls lead with a 16px Phosphor icon; the copy icon turns into an accent tick once copied. */
  .copy,
  .md {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 200ms var(--ease);
  }
  .i {
    flex: none;
    width: 16px;
    height: 16px;
  }
  .copy .i-done,
  .copy.done .i-copy {
    display: none;
  }
  .copy.done .i-done {
    display: block;
    color: var(--accent);
  }
  .md:hover .ul {
    text-decoration-thickness: 2px;
  }

  h1 {
    font-size: clamp(34px, 3.2vw, 46px);
    font-weight: 500;
    line-height: 1.04;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }
  .dek {
    max-width: 34em;
    margin-top: 20px;
    font-size: var(--t-sm);
    line-height: 1.4;
    color: var(--muted);
    text-wrap: pretty;
  }
  .cover {
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 9;
    margin-top: 40px;
    overflow: hidden;
    background: var(--panel);
  }
  .cover :global(svg) {
    width: 100%;
    height: 100%;
    color: var(--ink);
  }
  .cover :global(.o) {
    fill: var(--spot);
  }
  .prose {
    margin-top: 48px;
  }
  .canon {
    max-width: 68ch;
    margin-top: 56px;
    font-size: var(--t-xs);
    color: var(--muted);
  }
  /* The sign-off: who wrote it and where to send corrections, muted under the prose and on its measure. */
  .by {
    max-width: 44em;
    margin-top: 40px;
    color: var(--muted);
    text-wrap: pretty;
  }
  .canon + .by {
    margin-top: 12px;
  }
  .by a {
    color: var(--ink);
  }
  @media (hover: hover) {
    .by a:hover {
      color: var(--accent);
    }
  }
  .by a:focus-visible {
    color: var(--accent);
  }
  .end {
    display: none;
  }
  .side .toc {
    margin-top: 0;
    padding-top: 28px;
    border-top: 1px solid var(--line);
  }

  /* More blogs reads like the home page's Blogs (DESIGN.md §5): the h2 and its note at the margin, then the rows 40px
     under them on the home page's text edge (indented 112px at 1440, at most 1040px wide), covers in the --media
     column, and "Read all" as the last row. Each row fades up as it scrolls in. */
  .more {
    margin-top: 120px;
  }
  .more h2 {
    font-size: var(--t-l);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }
  .note {
    max-width: 36em;
    margin-top: 12px;
    color: var(--muted);
    text-wrap: pretty;
  }
  .list {
    max-width: 1040px;
    margin-top: 40px;
    margin-left: clamp(0px, 7.8vw, 112px);
  }
  @keyframes row-in {
    from {
      opacity: 0;
      translate: 0 12px;
    }
  }
  @media screen and (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .list li,
      .all {
        animation: row-in linear both;
      }
      :root :is(.list li, .all) {
        animation-timeline: view();
        animation-range: entry 10% entry 60%;
      }
    }
  }

  /* Under 1200px the rail has no room: the contents and Markdown controls follow the article. */
  @media (max-width: 1199px) {
    .end {
      display: block;
      margin-top: 56px;
      padding-top: 8px;
      border-top: 1px solid var(--line);
    }
    .end .toc {
      margin-top: 24px;
    }
    /* On touch the two controls sit a finger apart (their `.hit` areas meet, never overlap). */
    .end .tools {
      gap: 22px;
      margin-top: 32px;
    }
  }
  @media (max-width: 720px) {
    .post {
      padding-top: calc(var(--head-h) + 40px);
    }
    h1 {
      letter-spacing: -0.03em;
    }
    .cover {
      margin-top: 36px;
    }
    .prose {
      margin-top: 40px;
    }
    .end .toc {
      display: none;
    }
    .end .tools {
      margin-top: 24px;
    }
    .more {
      margin-top: 88px;
    }
    .list {
      margin-top: 24px;
      margin-left: 0;
    }
  }
</style>
