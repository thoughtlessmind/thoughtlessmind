---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getPosts } from '../../lib/blogs';

// Every post, grouped by year, newest first, each as the home page's wide row (PostCard): its cover morphs into the
// post's own cover on navigation.
const posts = await getPosts();
const years = [...Map.groupBy(posts, (p) => p.data.date.getUTCFullYear())];
const first = posts.at(-1)?.data.date.getUTCFullYear();
const count = `${posts.length} ${posts.length === 1 ? 'post' : 'posts'}${first ? ` since ${first}` : ''}`;
---

<BaseLayout
  title="Blogs by Rajiv Kumar, software engineer"
  description="Rajiv Kumar on building for the web: React, TypeScript and CSS fixes, and the problems I would rather solve once."
  current="blogs"
>
  <div class="list">
    <header class="head">
      <h1>Blogs</h1>
      <p class="dek">Notes on building for the web, and the problems I would rather solve once.</p>
      <p class="count">{count}</p>
    </header>
    <div class="years indent">
      {
        years.map(([year, list]) => (
          <section class="year" aria-labelledby={`y${year}`}>
            <h2 class="yr" id={`y${year}`}>{year}</h2>
            <ol>
              {list.map((p) => (
                <li>
                  <PostCard post={p} wide />
                </li>
              ))}
            </ol>
          </section>
        ))
      }
    </div>
  </div>
</BaseLayout>

<style>
  /* Laid out like the home page's Blogs (DESIGN.md §5): the head at the left margin, then the posts under it on the
     home page's text edge (indented 112px at 1440, at most 1040px wide), covers in the --media column. */
  .list {
    padding-top: calc(var(--head-h) + 72px);
  }
  h1 {
    font-size: var(--t-xl);
    font-weight: 500;
    line-height: 1.08;
    letter-spacing: -0.025em;
  }
  .dek {
    max-width: 36em;
    margin-top: 16px;
    line-height: 1.5;
    color: var(--muted);
    text-wrap: pretty;
  }
  .count {
    margin-top: 12px;
    font-size: var(--t-xs);
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .years {
    margin-top: 56px;
  }
  .year + .year {
    margin-top: 48px;
  }
  .yr {
    padding-top: 12px;
    border-top: 1px solid var(--line);
    font-size: var(--t-xs);
    font-weight: 400;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  /* The year's hairline stands in for the first row's. */
  li:first-child > :global(.post) {
    border-top: 0;
  }
  @media (max-width: 720px) {
    .list {
      padding-top: calc(var(--head-h) + 40px);
    }
    .years {
      margin-top: 40px;
    }
  }
</style>
