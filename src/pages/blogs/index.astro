---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Doodle from '../../components/Doodle.astro';
import PostCard from '../../components/PostCard.astro';
import { getPosts } from '../../lib/blogs';

// Every post, grouped by year, newest first, each as the home page's row (PostCard): its cover morphs into the
// post's own cover on navigation.
const posts = await getPosts();
const years = [...Map.groupBy(posts, (p) => p.data.date.getUTCFullYear())];
const first = posts.at(-1)?.data.date.getUTCFullYear();
const count = `${posts.length} ${posts.length === 1 ? 'post' : 'posts'}${first ? ` since ${first}` : ''}`;
---

<BaseLayout title="Blogs, Rajiv Kumar" description="Notes on building for the web, and the problems I would rather solve once." current="blogs">
  <div class="list">
    <header class="head">
      <h1>Blogs</h1>
      <p class="dek">Notes on building for the web, and the problems I would rather solve once.</p>
      <p class="count">{count}</p>
      <div class="sk" aria-hidden="true"><Doodle art="blogs" /></div>
    </header>
    <div class="years">
      {
        years.map(([year, list]) => (
          <section class="year" aria-labelledby={`y${year}`}>
            <h2 class="yr" id={`y${year}`}>{year}</h2>
            <ol>
              {list.map((p) => (
                <li>
                  <PostCard post={p} />
                </li>
              ))}
            </ol>
          </section>
        ))
      }
    </div>
  </div>
</BaseLayout>

<style>
  .list {
    display: grid;
    grid-template-columns: var(--cols);
    padding-top: calc(var(--head-h) + 72px);
  }
  .head {
    position: sticky;
    top: calc(var(--head-h) + 40px);
    align-self: start;
    padding-right: 48px;
  }
  h1 {
    font-size: var(--t-xl);
    font-weight: 500;
    line-height: 0.98;
    letter-spacing: -0.045em;
  }
  .dek {
    max-width: 22em;
    margin-top: 20px;
    font-size: var(--t-sm);
    line-height: 1.4;
    color: var(--muted);
    text-wrap: pretty;
  }
  .count {
    margin-top: 20px;
    font-size: var(--t-xs);
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  /* The home page's Blogs doodle, here too: the pencil sketch under the head, inked by a mouse (Doodle.astro). */
  .sk {
    width: min(100%, 300px);
    height: clamp(180px, 100svh - var(--head-h) - 480px, 270px);
    margin-top: 56px;
  }

  .year + .year {
    margin-top: 48px;
  }
  .yr {
    padding-top: 12px;
    border-top: 1px solid var(--line);
    font-size: var(--t-xs);
    font-weight: 400;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  /* The year's hairline stands in for the first row's. */
  li:first-child > :global(.post) {
    border-top: 0;
  }

  /* One column: the head on top, not sticky. */
  @media (max-width: 999px) {
    .list {
      display: block;
    }
    .head {
      position: static;
      padding-right: 0;
    }
    .sk {
      display: none;
    }
    .years {
      margin-top: 56px;
    }
  }
  @media (max-width: 720px) {
    .list {
      padding-top: calc(var(--head-h) + 40px);
    }
    h1 {
      line-height: 1;
      letter-spacing: -0.04em;
    }
  }
</style>
